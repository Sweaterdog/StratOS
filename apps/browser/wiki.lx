// DOCTYPE {AOT}
// ============================================================================
// VoidSearch Encyclopedia — Built-in knowledge base for Void Browser
// apps/browser/wiki.lx
//
// Contains 15 encyclopedia articles covering computing, science,
// technology, and general knowledge. Provides search matching and
// page rendering for the browser's built-in search engine.
// ============================================================================

import "kernel/drivers/framebuffer.lx";
import "apps/lib/textrender.lx";
import "system/windowing/theme.lx";

int WIKI_ARTICLE_COUNT = 15;

export class Wiki {

    public static func getArticleCount() -> int {
        return WIKI_ARTICLE_COUNT;
    }

    # ========================================================================
    # Article Data Accessors
    # ========================================================================

    public static func getTitle(int id) -> string {
        switch (id) {
            case 0:  return "Operating Systems";
            case 1:  return "Programming Languages";
            case 2:  return "Computer Networks";
            case 3:  return "Artificial Intelligence";
            case 4:  return "Cryptography";
            case 5:  return "Space Exploration";
            case 6:  return "Mathematics";
            case 7:  return "Physics";
            case 8:  return "Climate Science";
            case 9:  return "World Wide Web";
            case 10: return "Open Source Software";
            case 11: return "Quantum Computing";
            case 12: return "Robotics";
            case 13: return "Video Game History";
            case 14: return "Renewable Energy";
            default: return "Unknown Article";
        }
    }

    public static func getKeywords(int id) -> string {
        switch (id) {
