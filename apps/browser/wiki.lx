    private static func drawPhysics(int lx, int ly, int h) -> int {
        TextRender.drawText("Physics is the natural science that studies matter, energy,", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("motion, and force — the fundamental rules governing the", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("behavior of the universe.", lx, ly, 0xC9D1D9FF); ly = ly + h * 2;
        TextRender.drawText("Key Areas:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  Classical Mechanics — Newton's laws of motion", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Electromagnetism — Electric and magnetic forces", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Thermodynamics — Heat, work, and energy transfer", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Quantum Mechanics — Subatomic particle behavior", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  General Relativity — Gravity as curved spacetime", lx, ly, 0x8B949EFF); ly = ly + h * 2;
        TextRender.drawText("Physics explains phenomena from falling apples to black", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("holes, and underpins all modern technology.", lx, ly, 0xC9D1D9FF);
        return ly;
    }

    private static func drawClimate(int lx, int ly, int h) -> int {
        TextRender.drawText("Climate science studies long-term patterns of temperature,", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("precipitation, wind, and other atmospheric conditions.", lx, ly, 0xC9D1D9FF); ly = ly + h * 2;
        TextRender.drawText("Key Concepts:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  Greenhouse Effect — Gases trap heat in the atmosphere", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Carbon Cycle — Movement of carbon through ecosystems", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Ice Cores — Historical climate data from glacial ice", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Ocean Currents — Distribute heat around the globe", lx, ly, 0x8B949EFF); ly = ly + h * 2;
        TextRender.drawText("Human activities, especially burning fossil fuels, have", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("significantly increased atmospheric CO2, leading to global", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("warming and shifting weather patterns worldwide.", lx, ly, 0xC9D1D9FF);
        return ly;
    }

    private static func drawWWW(int lx, int ly, int h) -> int {
        TextRender.drawText("The World Wide Web (WWW) is an information system where", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("documents and resources are identified by URLs, linked by", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("hypertext, and accessed via the Internet.", lx, ly, 0xC9D1D9FF); ly = ly + h * 2;
        TextRender.drawText("History:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  1989 — Tim Berners-Lee proposes the Web at CERN", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  1991 — First website goes live", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  1993 — Mosaic browser makes the Web popular", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  1995 — JavaScript and dynamic content emerge", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  2004 — Web 2.0 era of social media begins", lx, ly, 0x8B949EFF); ly = ly + h * 2;
        TextRender.drawText("Core technologies include HTML, CSS, JavaScript, HTTP,", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("and URLs. The Web transformed global communication.", lx, ly, 0xC9D1D9FF);
        return ly;
    }

    private static func drawOpenSource(int lx, int ly, int h) -> int {
        TextRender.drawText("Open source software (OSS) is software with source code", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("that anyone can inspect, modify, and distribute freely.", lx, ly, 0xC9D1D9FF); ly = ly + h * 2;
        TextRender.drawText("Principles:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  Transparency — Source code is publicly available", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Collaboration — Community-driven development model", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Freedom — Users can modify and redistribute code", lx, ly, 0x8B949EFF); ly = ly + h * 2;
        TextRender.drawText("Major Licenses:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  GPL — Copyleft, derivative works must remain open", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  MIT — Permissive, minimal restrictions on reuse", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Apache 2.0 — Permissive with patent protection", lx, ly, 0x8B949EFF); ly = ly + h * 2;
        TextRender.drawText("Notable projects: Linux, Firefox, Python, Git, and Flux.", lx, ly, 0xC9D1D9FF);
        return ly;
    }

    private static func drawQuantum(int lx, int ly, int h) -> int {
        TextRender.drawText("Quantum computing uses quantum-mechanical phenomena such", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("as superposition and entanglement to process information.", lx, ly, 0xC9D1D9FF); ly = ly + h * 2;
        TextRender.drawText("Core Concepts:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  Qubit — Quantum bit, can represent 0, 1, or both", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Superposition — Existing in multiple states at once", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Entanglement — Linked qubits share quantum state", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Quantum Gates — Operations that manipulate qubits", lx, ly, 0x8B949EFF); ly = ly + h * 2;
        TextRender.drawText("Applications:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  Factoring large numbers (Shor's algorithm)", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Database search acceleration (Grover's algorithm)", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Drug discovery and materials science simulation", lx, ly, 0x8B949EFF);
        return ly;
    }

    private static func drawRobotics(int lx, int ly, int h) -> int {
        TextRender.drawText("Robotics is the branch of engineering dealing with the", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("design, construction, and operation of robots.", lx, ly, 0xC9D1D9FF); ly = ly + h * 2;
        TextRender.drawText("Components:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  Sensors — Cameras, lidar, IMUs for perception", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Actuators — Motors and servos for movement", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Controllers — Microprocessors running algorithms", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Power — Batteries or external power supplies", lx, ly, 0x8B949EFF); ly = ly + h * 2;
        TextRender.drawText("Applications:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  Industrial — Assembly lines, welding, painting", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Medical — Surgical robots and prosthetic limbs", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Exploration — Mars rovers, deep-sea vehicles", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Consumer — Vacuum robots, personal assistants", lx, ly, 0x8B949EFF);
        return ly;
    }

    private static func drawGames(int lx, int ly, int h) -> int {
        TextRender.drawText("Video games are electronic games played on screens,", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("evolving from simple experiments to a global industry.", lx, ly, 0xC9D1D9FF); ly = ly + h * 2;
        TextRender.drawText("Timeline:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  1972 — Pong, one of the first arcade titles", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  1977 — Atari 2600 brings gaming into homes", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  1985 — NES revives the console market", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  1994 — PlayStation launches the 3D gaming era", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  2004 — Online multiplayer becomes mainstream", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  2016 — VR headsets reach consumers", lx, ly, 0x8B949EFF); ly = ly + h * 2;
        TextRender.drawText("Modern engines like Unreal and Unity enable both indie", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("developers and large studios to create immersive worlds.", lx, ly, 0xC9D1D9FF);
        return ly;
    }

    private static func drawEnergy(int lx, int ly, int h) -> int {
        TextRender.drawText("Renewable energy comes from sources that naturally replenish", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("on a human timescale, unlike fossil fuels.", lx, ly, 0xC9D1D9FF); ly = ly + h * 2;
        TextRender.drawText("Sources:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  Solar — Photovoltaic cells convert sunlight to power", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Wind — Turbines harness kinetic energy of air flow", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Hydroelectric — Dams generate power from falling water", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Geothermal — Earth's interior heat drives turbines", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Biomass — Organic materials converted to fuel or power", lx, ly, 0x8B949EFF); ly = ly + h * 2;
        TextRender.drawText("Renewable energy is critical for reducing greenhouse gas", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("emissions and achieving long-term sustainability goals.", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("Global capacity has grown rapidly in the 21st century.", lx, ly, 0xC9D1D9FF);
        return ly;
    }
}
