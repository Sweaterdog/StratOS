    public static func getPreview(int id) -> string {
        switch (id) {
            case 0:  return "System software that manages computer hardware and resources.";
            case 1:  return "Formal languages for expressing computational instructions.";
            case 2:  return "Interconnected devices sharing data via standardized protocols.";
            case 3:  return "Systems designed to simulate human intelligence and learning.";
            case 4:  return "Techniques for secure communication and data protection.";
            case 5:  return "The investigation and exploration of outer space by humanity.";
            case 6:  return "The abstract science of number, quantity, and space.";
            case 7:  return "The study of matter, energy, and the fundamental forces of nature.";
            case 8:  return "The study of long-term weather patterns and global changes.";
            case 9:  return "A system of interlinked hypertext documents accessed via the Internet.";
            case 10: return "Software released with source code freely available to modify.";
            case 11: return "Computing that uses quantum-mechanical phenomena like superposition.";
            case 12: return "Machines capable of carrying out complex actions automatically.";
            case 13: return "The evolution of electronic interactive entertainment over decades.";
            case 14: return "Energy collected from naturally replenishing sources like sun and wind.";
