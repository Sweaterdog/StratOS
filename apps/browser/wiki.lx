            case 1:  return "code compiler interpreter syntax paradigm runtime type";
            case 2:  return "internet tcp ip packet routing protocol lan wan dns server";
            case 3:  return "ai machine learning neural network deep model training data";
            case 4:  return "encryption cipher hash key security digital certificate rsa aes";
            case 5:  return "nasa rocket moon mars satellite orbit apollo mission astronaut";
            case 6:  return "algebra calculus geometry number proof theorem equation pi";
            case 7:  return "mechanics relativity quantum thermodynamics force energy atom";
            case 8:  return "climate temperature co2 greenhouse warming earth weather ocean";
            case 9:  return "html http browser url website tim berners lee hypertext server";
            case 10: return "linux gpl free license community gnu github fork open code";
            case 11: return "qubit superposition entanglement gate algorithm shor grover";
            case 12: return "robot sensor actuator autonomous arm industrial drone control";
            case 13: return "game console nintendo atari pong arcade pixel retro engine unity";
            case 14: return "solar wind hydro geothermal sustainable power electricity clean";
