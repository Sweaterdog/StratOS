        TextRender.drawText("intelligence by computer systems, encompassing learning,", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("reasoning, problem-solving, and language understanding.", lx, ly, 0xC9D1D9FF); ly = ly + h * 2;
        TextRender.drawText("Branches:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  Machine Learning — Systems that learn from data", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Deep Learning — Neural networks with many layers", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  NLP — Natural Language Processing for text and speech", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Computer Vision — Understanding images and video", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Reinforcement Learning — Learning by trial and error", lx, ly, 0x8B949EFF); ly = ly + h * 2;
        TextRender.drawText("Applications include autonomous vehicles, medical diagnosis,", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("language translation, and game-playing systems.", lx, ly, 0xC9D1D9FF);
        return ly;
    }

    private static func drawCrypto(int lx, int ly, int h) -> int {
        TextRender.drawText("Cryptography is the practice of securing information by", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("transforming it into an unreadable format for unauthorized", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("users, while allowing authorized parties to read it.", lx, ly, 0xC9D1D9FF); ly = ly + h * 2;
        TextRender.drawText("Methods:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  Symmetric — Same key encrypts and decrypts (AES)", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Asymmetric — Public/private key pairs (RSA, ECC)", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Hashing — One-way function producing fixed digest (SHA)", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Digital Signatures — Verify identity and integrity", lx, ly, 0x8B949EFF); ly = ly + h * 2;
        TextRender.drawText("Cryptography underpins internet security, banking, and", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("blockchain technology. It dates back thousands of years", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("to the Caesar cipher used in ancient Rome.", lx, ly, 0xC9D1D9FF);
        return ly;
    }

