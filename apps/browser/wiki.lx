    # Convert an article ID to its URL string
    public static func wikiUrl(int id) -> string {
        switch (id) {
            case 0:  return "stratos://wiki/0";
            case 1:  return "stratos://wiki/1";
            case 2:  return "stratos://wiki/2";
            case 3:  return "stratos://wiki/3";
            case 4:  return "stratos://wiki/4";
            case 5:  return "stratos://wiki/5";
            case 6:  return "stratos://wiki/6";
            case 7:  return "stratos://wiki/7";
            case 8:  return "stratos://wiki/8";
            case 9:  return "stratos://wiki/9";
            case 10: return "stratos://wiki/10";
            case 11: return "stratos://wiki/11";
            case 12: return "stratos://wiki/12";
            case 13: return "stratos://wiki/13";
            case 14: return "stratos://wiki/14";
            default: return "stratos://wiki/0";
        }
    }

    # Convert a small number (0-15) to its string representation
    public static func numToStr(int n) -> string {
        switch (n) {
            case 0: return "0";   case 1: return "1";
            case 2: return "2";   case 3: return "3";
            case 4: return "4";   case 5: return "5";
            case 6: return "6";   case 7: return "7";
            case 8: return "8";   case 9: return "9";
            case 10: return "10"; case 11: return "11";
            case 12: return "12"; case 13: return "13";
            case 14: return "14"; case 15: return "15";
            default: return "?";
        }
    }

    # ========================================================================
    # Search Matching
    # ========================================================================

    # Check if an article matches a search query (case-insensitive)
    # Supports multi-word queries (all words must match title or keywords)
    public static func matchesQuery(int id, string query) -> bool {
        if (query.length == 0) return false;
        string q = query.toLower().trim();
        if (q.length == 0) return false;
        string t = getTitle(id).toLower();
        string k = getKeywords(id).toLower();
        string p = getPreview(id).toLower();

        # Try full query match first
        if (t.contains(q)) return true;
        if (k.contains(q)) return true;
        if (p.contains(q)) return true;

        # Split query into words and check each word matches at least one field
        int wordStart = 0;
        for (int i = 0; i <= q.length; i++) {
            bool isSep = false;
            if (i == q.length) {
                isSep = true;
            } elif (q.charAt(i) == ' ') {
                isSep = true;
            }
            if (isSep && i > wordStart) {
                string word = q.substring(wordStart, i);
                if (word.length > 0) {
                    bool wordFound = false;
                    if (t.contains(word)) wordFound = true;
                    if (k.contains(word)) wordFound = true;
                    if (p.contains(word)) wordFound = true;
                    if (!wordFound) return false;
                }
                wordStart = i + 1;
            } elif (isSep) {
                wordStart = i + 1;
            }
        }
        return true;
    }

    # Parse article ID from a wiki URL like "stratos://wiki/12"
    # Returns 0 on failure
    public static func parseWikiId(string url) -> int {
        # "stratos://wiki/" = 15 chars
        if (url.length <= 15) return 0;
        string num = url.substring(15, url.length);
        if (num == "0") return 0;
        if (num == "1") return 1;
        if (num == "2") return 2;
        if (num == "3") return 3;
        if (num == "4") return 4;
        if (num == "5") return 5;
        if (num == "6") return 6;
        if (num == "7") return 7;
        if (num == "8") return 8;
        if (num == "9") return 9;
        if (num == "10") return 10;
        if (num == "11") return 11;
        if (num == "12") return 12;
        if (num == "13") return 13;
        if (num == "14") return 14;
        return 0;
    }

    # Parse search query from URL like "stratos://search?q=hello"
    public static func parseSearchQuery(string url) -> string {
        # "stratos://search?q=" = 19 chars
        if (url.length <= 19) return "";
        return url.substring(19, url.length);
    }

    # ========================================================================
    # Search Results Page Renderer
    # ========================================================================

    public static func drawSearchPage(string query, int x, int y, int w, int h, int scrollY) -> void {
        int centerX = x + w / 2;
        int charW = TextRender.getCharWidth();

        # VoidSearch branding
        int logoY = y + 40 - scrollY;
        if (logoY > y - 40 && logoY < y + h) {
            Framebuffer.fillCircle(centerX, logoY, 22, 0x5B8CFF40);
            Framebuffer.fillCircle(centerX, logoY, 15, 0x5B8CFF80);
            Framebuffer.fillCircle(centerX, logoY, 8, 0x5B8CFFFF);
        }

        int titleY = logoY + 30;
        if (titleY > y && titleY < y + h) {
            string brand = "VoidSearch";
            int brandW = brand.length * charW;
            TextRender.drawText(brand, centerX - brandW / 2, titleY, 0xE6EDF3FF);
        }

        # "Results for: query"
        int queryY = titleY + 40;
        if (queryY > y && queryY < y + h) {
            string displayQ = query;
            if (displayQ.length > 40) displayQ = displayQ.substring(0, 40);
            string label = "Results for: " + displayQ;
            TextRender.drawText(label, x + 40, queryY, 0x8B949EFF);
        }

        # Divider
        int divY = queryY + 25;
        if (divY > y && divY < y + h) {
            Framebuffer.drawHLine(x + 40, divY, w - 80, 0x21262DFF);
        }

        # Count matches
        int matchCount = 0;
        for (int i = 0; i < WIKI_ARTICLE_COUNT; i++) {
            if (matchesQuery(i, query)) matchCount = matchCount + 1;
        }

        int countY = divY + 10;
        if (countY > y && countY < y + h) {
            string countStr = numToStr(matchCount) + " results found";
            TextRender.drawText(countStr, x + 40, countY, 0x6B7280FF);
        }

        # List matching articles
        int resultY = countY + 30;
        int resultIdx = 0;
        for (int i = 0; i < WIKI_ARTICLE_COUNT; i++) {
            if (!matchesQuery(i, query)) continue;
            if (resultIdx >= 10) break;

            int ry = resultY + resultIdx * 72;
            if (ry > y + h) break;
            if (ry + 60 > y) {
                # Accent dot
                Framebuffer.fillCircle(x + 48, ry + 6, 3, Theme.textAccent);

                # Title (accent color — clickable)
                string title = getTitle(i);
                TextRender.drawText(title, x + 60, ry, Theme.textAccent);

                # URL in green
                string wUrl = wikiUrl(i);
                TextRender.drawText(wUrl, x + 60, ry + 18, 0x56D364FF);

                # Preview text
                string prev = getPreview(i);
                int maxChars = (w - 110) / charW;
                if (prev.length > maxChars) {
                    prev = prev.substring(0, maxChars);
                }
                TextRender.drawText(prev, x + 60, ry + 36, 0x6B7280FF);
            }
            resultIdx = resultIdx + 1;
        }

        # No results message
        if (matchCount == 0) {
            int noY = resultY;
            if (noY > y && noY < y + h) {
                TextRender.drawText("No results found.", x + 48, noY, 0x6B7280FF);
                TextRender.drawText("Try different keywords or browse:", x + 48, noY + 28, 0x484F58FF);
                TextRender.drawText("stratos://home", x + 48, noY + 50, Theme.textAccent);
            }
        }
    }

    # Handle click on search results page — returns URL to navigate to, or ""
    public static func handleSearchClick(string query, int pageRelY) -> string {
        # Page layout (absolute positions from page top):
        #   logoY=40, titleY=70, queryY=110, divY=135, countY=145, resultY=175
        int resultStartY = 175;
        int resultH = 72;

        if (pageRelY < resultStartY) return "";
        int clickedIdx = (pageRelY - resultStartY) / resultH;
        if (clickedIdx < 0) return "";
        if (clickedIdx >= 10) return "";

        # Find the Nth matching article
        int matchIdx = 0;
        for (int i = 0; i < WIKI_ARTICLE_COUNT; i++) {
            if (!matchesQuery(i, query)) continue;
            if (matchIdx == clickedIdx) {
                return wikiUrl(i);
            }
            matchIdx = matchIdx + 1;
        }
        return "";
    }

    # ========================================================================
    # Wiki Article Page Renderer
    # ========================================================================

    public static func drawArticlePage(int id, int x, int y, int w, int h, int scrollY) -> void {
        int lx = x + 40;
        int ly = y + 30 - scrollY;
        int lineH = 22;

        # Article title
        TextRender.drawText(getTitle(id), lx, ly, 0xE6EDF3FF);
        ly = ly + lineH;

        # Subtitle
        TextRender.drawText("From VoidSearch Encyclopedia", lx, ly, 0x6B7280FF);
        ly = ly + lineH;

        # Divider
        Framebuffer.drawHLine(lx, ly + 4, w - 80, 0x21262DFF);
        ly = ly + lineH;

        # Article body — dispatched by ID
        switch (id) {
            case 0:  ly = drawOS(lx, ly, lineH); break;
            case 1:  ly = drawLangs(lx, ly, lineH); break;
            case 2:  ly = drawNetworks(lx, ly, lineH); break;
            case 3:  ly = drawAI(lx, ly, lineH); break;
            case 4:  ly = drawCrypto(lx, ly, lineH); break;
            case 5:  ly = drawSpace(lx, ly, lineH); break;
            case 6:  ly = drawMath(lx, ly, lineH); break;
            case 7:  ly = drawPhysics(lx, ly, lineH); break;
            case 8:  ly = drawClimate(lx, ly, lineH); break;
            case 9:  ly = drawWWW(lx, ly, lineH); break;
            case 10: ly = drawOpenSource(lx, ly, lineH); break;
            case 11: ly = drawQuantum(lx, ly, lineH); break;
            case 12: ly = drawRobotics(lx, ly, lineH); break;
            case 13: ly = drawGames(lx, ly, lineH); break;
            case 14: ly = drawEnergy(lx, ly, lineH); break;
        }

        # Back link
        ly = ly + lineH * 2;
        TextRender.drawText("<< Back to search results", lx, ly, Theme.textAccent);
    }

    # ========================================================================
    # Article Content Renderers
    # ========================================================================

    private static func drawOS(int lx, int ly, int h) -> int {
        TextRender.drawText("An operating system (OS) is system software that manages", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("computer hardware and software resources, providing common", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("services for computer programs.", lx, ly, 0xC9D1D9FF); ly = ly + h * 2;
        TextRender.drawText("Key Components:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  Kernel — Core managing CPU, memory, and devices", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Scheduler — Allocates CPU time to running processes", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Memory Manager — Handles virtual memory and paging", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  File System — Organizes and stores data on disk", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Drivers — Interface between hardware and OS kernel", lx, ly, 0x8B949EFF); ly = ly + h * 2;
        TextRender.drawText("Popular examples include Linux, Windows, macOS, FreeBSD,", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("and StratOS. Modern operating systems support multitasking,", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("memory protection, and graphical user interfaces.", lx, ly, 0xC9D1D9FF);
        return ly;
    }

    private static func drawLangs(int lx, int ly, int h) -> int {
        TextRender.drawText("A programming language is a formal set of instructions that", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("can be used to produce programs and control machines.", lx, ly, 0xC9D1D9FF); ly = ly + h * 2;
        TextRender.drawText("Classification:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  Low-level — Assembly, machine code (close to hardware)", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  High-level — Python, Java, C++ (human-readable syntax)", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Compiled — Translated to machine code before running", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Interpreted — Executed line by line by an interpreter", lx, ly, 0x8B949EFF); ly = ly + h * 2;
        TextRender.drawText("Paradigms:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  Imperative, Object-Oriented, Functional, Declarative,", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Logic-based, and Multi-paradigm approaches.", lx, ly, 0x8B949EFF); ly = ly + h * 2;
        TextRender.drawText("Flux is an example of a modern compiled language designed", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("for systems programming and application development.", lx, ly, 0xC9D1D9FF);
        return ly;
    }

    private static func drawNetworks(int lx, int ly, int h) -> int {
        TextRender.drawText("A computer network is a set of devices connected together", lx, ly, 0xC9D1D9FF); ly = ly + h;
        TextRender.drawText("to share resources and exchange data using protocols.", lx, ly, 0xC9D1D9FF); ly = ly + h * 2;
        TextRender.drawText("Network Types:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  LAN — Local Area Network (home, office)", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  WAN — Wide Area Network (city, country, global)", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  Internet — Global network connecting billions of devices", lx, ly, 0x8B949EFF); ly = ly + h * 2;
        TextRender.drawText("Key Protocols:", lx, ly, 0xE6EDF3FF); ly = ly + h;
        TextRender.drawText("  TCP/IP — Reliable data transmission across networks", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  HTTP — HyperText Transfer Protocol for web pages", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  DNS — Domain Name System to resolve hostnames to IPs", lx, ly, 0x8B949EFF); ly = ly + h;
        TextRender.drawText("  TLS — Transport Layer Security for encrypted links", lx, ly, 0x8B949EFF);
        return ly;
    }

