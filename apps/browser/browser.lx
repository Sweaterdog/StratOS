import "kernel/drivers/net.lx";
import "apps/lib/textrender.lx";
import "system/windowing/theme.lx";
import "apps/browser/wiki.lx";

# Browser state
string browserUrl = "stratos://home";
string browserTitle = "Home";
int browserScrollY = 0;

# Tab storage (parallel arrays, max 6 tabs)
int browserTabCount = 1;
int browserActiveTab = 0;
string tabUrl0  = "stratos://home"; string tabTitle0  = "Home"; int tabScrollY0  = 0;
string tabUrl1  = ""; string tabTitle1  = ""; int tabScrollY1  = 0;
string tabUrl2  = ""; string tabTitle2  = ""; int tabScrollY2  = 0;
string tabUrl3  = ""; string tabTitle3  = ""; int tabScrollY3  = 0;
string tabUrl4  = ""; string tabTitle4  = ""; int tabScrollY4  = 0;
string tabUrl5  = ""; string tabTitle5  = ""; int tabScrollY5  = 0;

# URL input mode
bool browserUrlEditing = false;
string browserUrlInput = "";

# Bookmarks (parallel arrays, max 8)
int bookmarkCount = 3;
string bmkUrl0  = "stratos://home";    string bmkLabel0 = "Home";
string bmkUrl1  = "stratos://help";    string bmkLabel1 = "Help";
string bmkUrl2  = "stratos://about";   string bmkLabel2 = "About";
string bmkUrl3  = ""; string bmkLabel3 = "";
string bmkUrl4  = ""; string bmkLabel4 = "";
string bmkUrl5  = ""; string bmkLabel5 = "";
string bmkUrl6  = ""; string bmkLabel6 = "";
string bmkUrl7  = ""; string bmkLabel7 = "";
bool browserShowBookmarks = true;

# Layout
int BR_TAB_H     = 28;
int BR_TOOLBAR_H = 36;
int BR_TAB_W     = 140;
int BR_BOOKMARK_H = 22;

# Search engine state
bool homeSearchEditing = false;
string homeSearchInput = "";
string searchQuery = "";
int currentWikiId = -1;

# ── HTTP page state ──────────────────────────────────────────────────────────
# When we fetch an http:// URL, we store up to 128 lines of plain text here.
# The browser renders these lines with drawText; it is NOT an HTML engine.
int HTTP_MAX_LINES   = 128;
int httpLineCount    = 0;
bool httpLoading     = false;
bool httpError       = false;
string httpErrorMsg  = "";
string httpHost      = "";
int httpStatusCode   = 0;

# Parallel string arrays for fetched content lines (max 128)
string hl0   = ""; string hl1   = ""; string hl2   = ""; string hl3   = "";
string hl4   = ""; string hl5   = ""; string hl6   = ""; string hl7   = "";
string hl8   = ""; string hl9   = ""; string hl10  = ""; string hl11  = "";
