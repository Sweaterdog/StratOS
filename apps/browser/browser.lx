    # ========================================================================
    # HTTP page fetch and render
    # ========================================================================

    # Fetch a page via HTTP GET over the kernel TCP stack.
    # Splits the response body into lines and stores in hl0..hl127.
    private static func fetchHttpPage(string url) -> void {
        httpLineCount = 0;
        httpLoading   = true;
        httpError     = false;
        httpErrorMsg  = "";
        httpStatusCode = 0;

        # ── Check adapter ────────────────────────────────────────
        if (!E1000.isPresent()) {
            httpLoading = false;
            httpError   = true;
            httpErrorMsg = "No network adapter detected";
            browserTitle = "Network Error";
            return;
        }
        if (!Net.isConfigured()) {
            httpLoading = false;
            httpError   = true;
            httpErrorMsg = "Network not configured (no IP address)";
            browserTitle = "Network Error";
            return;
        }

        # ── Parse host + path from the URL ───────────────────────
        # Expected: http://host/path  or  http://host
        string remainder = "";
        if (url.indexOf("http://") == 0) {
            remainder = url.substring(7, url.length);
        } elif (url.indexOf("https://") == 0) {
            # Note: TLS is not supported — treat as plain HTTP
            remainder = url.substring(8, url.length);
        }

        string host = remainder;
        string path = "/";
        int slashPos = remainder.indexOf("/");
        if (slashPos > 0) {
            host = remainder.substring(0, slashPos);
            path = remainder.substring(slashPos, remainder.length);
        }
        httpHost = host;

        # ── DNS resolve ──────────────────────────────────────────
        int ip = Net.dnsResolve(host);
        if (ip == 0) {
            httpLoading = false;
            httpError   = true;
            httpErrorMsg = "DNS lookup failed for ${host}";
            browserTitle = "DNS Error";
            return;
        }

        # ── TCP connect (port 80) ────────────────────────────────
        bool connected = Net.tcpConnect(ip, 80);
        if (!connected) {
            httpLoading = false;
            httpError   = true;
            httpErrorMsg = "Connection refused by ${host}:80";
            browserTitle = "Connection Error";
            return;
        }

        # ── Send HTTP/1.0 GET request ────────────────────────────
        string crlf = "\r\n";
        string req = "GET ${path} HTTP/1.0${crlf}Host: ${host}${crlf}User-Agent: VoidBrowser/0.1 (StratOS)${crlf}Accept: text/html, text/plain${crlf}Connection: close${crlf}${crlf}";
        long reqAddr = (long) req.c_str();
        Net.tcpSend(reqAddr, req.length);

        # ── Receive response into a byte buffer ──────────────────
        int recvBufSize = 8192;
        unsafe {
            byte recvBuf[8192];
            long recvAddr = (long) &recvBuf[0];
            int recvLen = Net.tcpReceive(recvAddr, recvBufSize, 5000);
            Net.tcpClose();

            if (recvLen <= 0) {
                httpLoading = false;
                httpError   = true;
                httpErrorMsg = "Empty response from ${host}";
                browserTitle = "Error";
                return;
            }

            # Build a string from the received bytes
            string response = "";
            for (int ri = 0; ri < recvLen; ri++) {
                int ch = (int) recvBuf[ri];
                if (ch >= 32 && ch < 127) {
                    response = "${response}${(string) ch}";
                } elif (ch == 10) {
                    response = "${response}\n";
                } elif (ch == 13) {
                    # skip CR
                } elif (ch == 9) {
                    response = "${response}    ";
                }
            }

            # ── Separate headers from body ───────────────────────────
            string body = response;
            int headerEnd = response.indexOf("\n\n");
            if (headerEnd >= 0) {
                body = response.substring(headerEnd + 2, response.length);

                # Parse status code from first line (e.g. "HTTP/1.0 200 OK")
                string statusLine = response.substring(0, headerEnd);
                int spPos = statusLine.indexOf(" ");
                if (spPos > 0) {
                    int spEnd = spPos + 4;
                    if (spEnd > statusLine.length) spEnd = statusLine.length;
                    string codeStr = statusLine.substring(spPos + 1, spEnd);
                    httpStatusCode = parseStatusCode(codeStr);
                }
            }

            # ── Strip HTML tags (very basic) ─────────────────────────
            string plain = stripHtmlTags(body);

            # ── Split into lines ─────────────────────────────────────
            int lineIdx = 0;
            int pos = 0;
            int plainLen = plain.length;
            while (pos < plainLen && lineIdx < HTTP_MAX_LINES) {
                int nlPos = -1;
                # Find next newline
                int scanLimit = pos + 200;
                if (scanLimit > plainLen) scanLimit = plainLen;
                for (int s = pos; s < scanLimit; s++) {
                    if (plain.charAt(s) == '\n') {
                        nlPos = s;
                        break;
                    }
                }
                if (nlPos < 0) {
                    # No newline found — take the rest (up to 200 chars)
                    string line = plain.substring(pos, scanLimit);
                    if (line.length > 0) {
                        setHttpLine(lineIdx, line.trim());
                        lineIdx = lineIdx + 1;
                    }
                    pos = scanLimit;
                } else {
                    string line = plain.substring(pos, nlPos);
                    if (line.length > 0) {
                        setHttpLine(lineIdx, line.trim());
                        lineIdx = lineIdx + 1;
                    }
                    pos = nlPos + 1;
                }
            }
            httpLineCount = lineIdx;
        }

        httpLoading = false;
        browserTitle = httpHost;
    }

    # Very basic HTML tag stripper: removes anything between < and >
    private static func stripHtmlTags(string input) -> string {
        string result = "";
        bool inTag = false;
        int len = input.length;
        for (int i = 0; i < len; i++) {
            if (input.charAt(i) == '<') {
                inTag = true;
            } elif (input.charAt(i) == '>') {
                inTag = false;
                # Insert space after block-level tags to separate words
                result = "${result} ";
            } else {
                if (!inTag) {
                    # Convert &amp; &lt; &gt; &nbsp; entities (basic)
                    result = "${result}${(string) input.charAt(i)}";
                }
            }
        }
        return result;
    }

    # Parse a 3-digit HTTP status code string to an int
    private static func parseStatusCode(string s) -> int {
        if (s.length < 3) return 0;
        int d0 = (int) s.charAt(0) - 48;
        int d1 = (int) s.charAt(1) - 48;
        int d2 = (int) s.charAt(2) - 48;
        if (d0 < 0 || d0 > 9) return 0;
        if (d1 < 0 || d1 > 9) return 0;
        if (d2 < 0 || d2 > 9) return 0;
        return d0 * 100 + d1 * 10 + d2;
    }

    # Render the fetched HTTP content
    private static func drawHttpPage(int x, int y, int w, int h) -> void {
        int lx = x + 16;
        int ly = y + 12 - browserScrollY;
        int lineH = 18;

        if (httpError) {
            # ── Error display ────────────────────────────────────
            int centerX = x + w / 2;
            int centerY = y + h / 2 - 40;

            Framebuffer.drawCircle(centerX, centerY, 30, 0xF85149FF);
            TextRender.drawText("!", centerX - 3, centerY - 8, 0xF85149FF);

            int errW = httpErrorMsg.length * 8;
            TextRender.drawText(httpErrorMsg, centerX - errW / 2, centerY + 50, 0xC9D1D9FF);

            string urlMsg = browserUrl;
            int urlMsgW = urlMsg.length * 8;
            TextRender.drawText(urlMsg, centerX - urlMsgW / 2, centerY + 72, 0x484F58FF);
            return;
        }

        if (httpLoading) {
            TextRender.drawText("Loading...", lx, ly, 0x8B949EFF);
            return;
        }

        # ── Status bar ──────────────────────────────────────────
        Framebuffer.fillRect(x, y, w, 24, 0x161B22FF);
        string statusText = "${httpHost}  —  HTTP ${httpStatusCode}  —  ${httpLineCount} lines";
        TextRender.drawText(statusText, lx, y + 4, 0x8B949EFF);
        ly = y + 30 - browserScrollY;

        # ── Content lines ───────────────────────────────────────
        for (int i = 0; i < httpLineCount; i++) {
            if (ly > y + 24 && ly < y + h) {
                string line = getHttpLine(i);
                TextRender.drawText(line, lx, ly, 0xC9D1D9FF);
            }
            ly = ly + lineH;
        }

        if (httpLineCount == 0) {
            TextRender.drawText("(empty response)", lx, ly, 0x484F58FF);
        }
    }

    # ── HTTP line parallel-array accessors ───────────────────────
    private static func getHttpLine(int i) -> string {
        switch (i) {
            case 0: return hl0; case 1: return hl1; case 2: return hl2; case 3: return hl3;
            case 4: return hl4; case 5: return hl5; case 6: return hl6; case 7: return hl7;
            case 8: return hl8; case 9: return hl9; case 10: return hl10; case 11: return hl11;
            case 12: return hl12; case 13: return hl13; case 14: return hl14; case 15: return hl15;
            case 16: return hl16; case 17: return hl17; case 18: return hl18; case 19: return hl19;
            case 20: return hl20; case 21: return hl21; case 22: return hl22; case 23: return hl23;
            case 24: return hl24; case 25: return hl25; case 26: return hl26; case 27: return hl27;
            case 28: return hl28; case 29: return hl29; case 30: return hl30; case 31: return hl31;
            case 32: return hl32; case 33: return hl33; case 34: return hl34; case 35: return hl35;
            case 36: return hl36; case 37: return hl37; case 38: return hl38; case 39: return hl39;
            case 40: return hl40; case 41: return hl41; case 42: return hl42; case 43: return hl43;
            case 44: return hl44; case 45: return hl45; case 46: return hl46; case 47: return hl47;
            case 48: return hl48; case 49: return hl49; case 50: return hl50; case 51: return hl51;
            case 52: return hl52; case 53: return hl53; case 54: return hl54; case 55: return hl55;
            case 56: return hl56; case 57: return hl57; case 58: return hl58; case 59: return hl59;
            case 60: return hl60; case 61: return hl61; case 62: return hl62; case 63: return hl63;
            case 64: return hl64; case 65: return hl65; case 66: return hl66; case 67: return hl67;
            case 68: return hl68; case 69: return hl69; case 70: return hl70; case 71: return hl71;
            case 72: return hl72; case 73: return hl73; case 74: return hl74; case 75: return hl75;
            case 76: return hl76; case 77: return hl77; case 78: return hl78; case 79: return hl79;
            case 80: return hl80; case 81: return hl81; case 82: return hl82; case 83: return hl83;
            case 84: return hl84; case 85: return hl85; case 86: return hl86; case 87: return hl87;
            case 88: return hl88; case 89: return hl89; case 90: return hl90; case 91: return hl91;
            case 92: return hl92; case 93: return hl93; case 94: return hl94; case 95: return hl95;
            case 96: return hl96; case 97: return hl97; case 98: return hl98; case 99: return hl99;
            case 100: return hl100; case 101: return hl101; case 102: return hl102; case 103: return hl103;
            case 104: return hl104; case 105: return hl105; case 106: return hl106; case 107: return hl107;
            case 108: return hl108; case 109: return hl109; case 110: return hl110; case 111: return hl111;
            case 112: return hl112; case 113: return hl113; case 114: return hl114; case 115: return hl115;
            case 116: return hl116; case 117: return hl117; case 118: return hl118; case 119: return hl119;
            case 120: return hl120; case 121: return hl121; case 122: return hl122; case 123: return hl123;
            case 124: return hl124; case 125: return hl125; case 126: return hl126; case 127: return hl127;
            default: return "";
        }
    }

    private static func setHttpLine(int i, string val) -> void {
        switch (i) {
            case 0: hl0 = val; break; case 1: hl1 = val; break; case 2: hl2 = val; break; case 3: hl3 = val; break;
            case 4: hl4 = val; break; case 5: hl5 = val; break; case 6: hl6 = val; break; case 7: hl7 = val; break;
            case 8: hl8 = val; break; case 9: hl9 = val; break; case 10: hl10 = val; break; case 11: hl11 = val; break;
            case 12: hl12 = val; break; case 13: hl13 = val; break; case 14: hl14 = val; break; case 15: hl15 = val; break;
            case 16: hl16 = val; break; case 17: hl17 = val; break; case 18: hl18 = val; break; case 19: hl19 = val; break;
            case 20: hl20 = val; break; case 21: hl21 = val; break; case 22: hl22 = val; break; case 23: hl23 = val; break;
            case 24: hl24 = val; break; case 25: hl25 = val; break; case 26: hl26 = val; break; case 27: hl27 = val; break;
            case 28: hl28 = val; break; case 29: hl29 = val; break; case 30: hl30 = val; break; case 31: hl31 = val; break;
            case 32: hl32 = val; break; case 33: hl33 = val; break; case 34: hl34 = val; break; case 35: hl35 = val; break;
            case 36: hl36 = val; break; case 37: hl37 = val; break; case 38: hl38 = val; break; case 39: hl39 = val; break;
            case 40: hl40 = val; break; case 41: hl41 = val; break; case 42: hl42 = val; break; case 43: hl43 = val; break;
            case 44: hl44 = val; break; case 45: hl45 = val; break; case 46: hl46 = val; break; case 47: hl47 = val; break;
            case 48: hl48 = val; break; case 49: hl49 = val; break; case 50: hl50 = val; break; case 51: hl51 = val; break;
            case 52: hl52 = val; break; case 53: hl53 = val; break; case 54: hl54 = val; break; case 55: hl55 = val; break;
            case 56: hl56 = val; break; case 57: hl57 = val; break; case 58: hl58 = val; break; case 59: hl59 = val; break;
            case 60: hl60 = val; break; case 61: hl61 = val; break; case 62: hl62 = val; break; case 63: hl63 = val; break;
            case 64: hl64 = val; break; case 65: hl65 = val; break; case 66: hl66 = val; break; case 67: hl67 = val; break;
            case 68: hl68 = val; break; case 69: hl69 = val; break; case 70: hl70 = val; break; case 71: hl71 = val; break;
            case 72: hl72 = val; break; case 73: hl73 = val; break; case 74: hl74 = val; break; case 75: hl75 = val; break;
            case 76: hl76 = val; break; case 77: hl77 = val; break; case 78: hl78 = val; break; case 79: hl79 = val; break;
            case 80: hl80 = val; break; case 81: hl81 = val; break; case 82: hl82 = val; break; case 83: hl83 = val; break;
            case 84: hl84 = val; break; case 85: hl85 = val; break; case 86: hl86 = val; break; case 87: hl87 = val; break;
            case 88: hl88 = val; break; case 89: hl89 = val; break; case 90: hl90 = val; break; case 91: hl91 = val; break;
            case 92: hl92 = val; break; case 93: hl93 = val; break; case 94: hl94 = val; break; case 95: hl95 = val; break;
            case 96: hl96 = val; break; case 97: hl97 = val; break; case 98: hl98 = val; break; case 99: hl99 = val; break;
            case 100: hl100 = val; break; case 101: hl101 = val; break; case 102: hl102 = val; break; case 103: hl103 = val; break;
            case 104: hl104 = val; break; case 105: hl105 = val; break; case 106: hl106 = val; break; case 107: hl107 = val; break;
            case 108: hl108 = val; break; case 109: hl109 = val; break; case 110: hl110 = val; break; case 111: hl111 = val; break;
            case 112: hl112 = val; break; case 113: hl113 = val; break; case 114: hl114 = val; break; case 115: hl115 = val; break;
            case 116: hl116 = val; break; case 117: hl117 = val; break; case 118: hl118 = val; break; case 119: hl119 = val; break;
            case 120: hl120 = val; break; case 121: hl121 = val; break; case 122: hl122 = val; break; case 123: hl123 = val; break;
            case 124: hl124 = val; break; case 125: hl125 = val; break; case 126: hl126 = val; break; case 127: hl127 = val; break;
        }
    }

    # ========================================================================
    # Bookmark management
    # ========================================================================

    private static func addBookmark(string url, string label) -> void {
        if (bookmarkCount >= 8) return;  # Max bookmarks reached

        # Check if already bookmarked
        for (int i = 0; i < bookmarkCount; i++) {
            if (getBmkUrl(i) == url) return;
        }

        setBmkUrl(bookmarkCount, url);
        setBmkLabel(bookmarkCount, label);
        bookmarkCount = bookmarkCount + 1;
    }

    private static func getBmkUrl(int i) -> string {
        switch (i) {
            case 0: return bmkUrl0;
            case 1: return bmkUrl1;
            case 2: return bmkUrl2;
            case 3: return bmkUrl3;
            case 4: return bmkUrl4;
            case 5: return bmkUrl5;
            case 6: return bmkUrl6;
            case 7: return bmkUrl7;
            default: return "";
        }
    }

    private static func getBmkLabel(int i) -> string {
        switch (i) {
            case 0: return bmkLabel0;
            case 1: return bmkLabel1;
            case 2: return bmkLabel2;
            case 3: return bmkLabel3;
            case 4: return bmkLabel4;
            case 5: return bmkLabel5;
            case 6: return bmkLabel6;
            case 7: return bmkLabel7;
            default: return "";
        }
    }

    private static func setBmkUrl(int i, string val) -> void {
        switch (i) {
            case 0: bmkUrl0 = val; break;
            case 1: bmkUrl1 = val; break;
            case 2: bmkUrl2 = val; break;
            case 3: bmkUrl3 = val; break;
            case 4: bmkUrl4 = val; break;
            case 5: bmkUrl5 = val; break;
            case 6: bmkUrl6 = val; break;
            case 7: bmkUrl7 = val; break;
        }
    }

    private static func setBmkLabel(int i, string val) -> void {
        switch (i) {
            case 0: bmkLabel0 = val; break;
            case 1: bmkLabel1 = val; break;
            case 2: bmkLabel2 = val; break;
            case 3: bmkLabel3 = val; break;
            case 4: bmkLabel4 = val; break;
            case 5: bmkLabel5 = val; break;
            case 6: bmkLabel6 = val; break;
            case 7: bmkLabel7 = val; break;
        }
    }
}
