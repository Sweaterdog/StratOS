export class BrowserApp {
    # Initialize the browser
    public static func init() -> void {
        browserUrl = "stratos://home";
        browserTitle = "Home";
        browserScrollY = 0;
        browserTabCount = 1;
        browserActiveTab = 0;
        tabUrl0 = "stratos://home";
        tabTitle0 = "Home";
        tabScrollY0 = 0;
        browserUrlEditing = false;
        browserUrlInput = "";
        homeSearchEditing = false;
        homeSearchInput = "";
        searchQuery = "";
        currentWikiId = -1;
    }

    # Process a keyboard event from the compositor
    public static func processKey(KeyEvent event) -> void {
        if (!event.pressed) return;

        # Home page search bar mode
        if (homeSearchEditing) {
            handleHomeSearch(event);
            return;
        }

        # URL editing mode
        if (browserUrlEditing) {
            handleUrlInput(event);
            return;
        }

        # Ctrl shortcuts
        if (event.ctrl) {
            if (event.ascii == 't') {
                newTab();
                return;
            }
            if (event.ascii == 'w') {
                closeTab(browserActiveTab);
                return;
            }
            if (event.ascii == 'l') {
                # Focus URL bar (clear for fresh input)
                browserUrlEditing = true;
                browserUrlInput = "";
                return;
            }
            if (event.ascii == 'r') {
                navigate(browserUrl);
                return;
            }
            if (event.ascii == 'd') {
                # Add current page to bookmarks
                addBookmark(browserUrl, browserTitle);
                return;
            }
            if (event.ascii == 'b') {
                # Toggle bookmark bar
                browserShowBookmarks = !browserShowBookmarks;
                return;
            }
            return;
        }

        # Navigation  
        if (event.scancode == KEY_UP) {
            browserScrollY = browserScrollY - 40;
            if (browserScrollY < 0) browserScrollY = 0;
            return;
        }
        if (event.scancode == KEY_DOWN) {
            browserScrollY = browserScrollY + 40;
            return;
        }
        if (event.scancode == 73) {
            # Page Up
            browserScrollY = browserScrollY - 300;
            if (browserScrollY < 0) browserScrollY = 0;
            return;
        }
        if (event.scancode == 81) {
            # Page Down
            browserScrollY = browserScrollY + 300;
            return;
        }
    }

    # Process a mouse click in the content area
    public static func processClick(int relX, int relY, int contentW, int contentH) -> void {
        # Tab bar region
        if (relY < BR_TAB_H) {
            int clickedTab = relX / BR_TAB_W;
            if (clickedTab >= 0 && clickedTab < browserTabCount) {
                switchTab(clickedTab);
            } elif (relX >= browserTabCount * BR_TAB_W && relX < browserTabCount * BR_TAB_W + 30) {
                # New tab button (+)
                newTab();
            }
            return;
        }

        # Toolbar region
        if (relY < BR_TAB_H + BR_TOOLBAR_H) {
            int toolRelX = relX;
            int toolRelY = relY - BR_TAB_H;
            # Back button (x: 8..36)
            if (toolRelX >= 8 && toolRelX < 36) {
                # Go back (no history stack in simplified version)
                return;
            }
            # Forward button (x: 40..68)
            if (toolRelX >= 40 && toolRelX < 68) {
                return;
            }
            # Reload button (x: 72..100)
            if (toolRelX >= 72 && toolRelX < 100) {
                navigate(browserUrl);
                return;
            }
            # URL bar (x: 110+)
            if (toolRelX >= 110) {
                browserUrlEditing = true;
                browserUrlInput = "";
                return;
            }
            return;
        }

        # Page content area — handle link clicks
        # Account for bookmark bar height
        int charW = TextRender.getCharWidth();
        int bmkH = 0;
        if (browserShowBookmarks && bookmarkCount > 0) bmkH = BR_BOOKMARK_H;

        # Bookmark bar click
        if (browserShowBookmarks && bookmarkCount > 0 && relY >= BR_TAB_H + BR_TOOLBAR_H && relY < BR_TAB_H + BR_TOOLBAR_H + BR_BOOKMARK_H) {
            int bx = 8;
            for (int i = 0; i < bookmarkCount; i++) {
                string label = getBmkLabel(i);
                if (label.length > 12) label = label.substring(0, 12);
                int labelW = label.length * charW + 16;
                if (relX >= bx && relX < bx + labelW) {
                    navigate(getBmkUrl(i));
                    return;
                }
                bx = bx + labelW + 4;
            }
            return;
        }

        int pageRelY = relY - BR_TAB_H - BR_TOOLBAR_H - bmkH + browserScrollY;
        if (browserUrl == "stratos://home") {
            # Home page search bar (at ~204px page absolute)
            if (pageRelY >= 204 && pageRelY < 240) {
                int searchW = 400;
                if (searchW > contentW - 40) searchW = contentW - 40;
                int searchBarX = contentW / 2 - searchW / 2;
                if (relX >= searchBarX && relX < searchBarX + searchW) {
                    homeSearchEditing = true;
                    homeSearchInput = "";
                    return;
                }
            }
            # Quick links at a known Y position (~260px from page top)
            if (pageRelY >= 260 && pageRelY < 340) {
                int linkIdx = (relX - contentW / 2 + 240) / 120;
                if (linkIdx == 0) navigate("stratos://about");
                elif (linkIdx == 1) navigate("stratos://help");
                elif (linkIdx == 2) navigate("stratos://settings");
                elif (linkIdx == 3) navigate("stratos://changelog");
            }
        } elif (browserUrl.indexOf("stratos://search") == 0) {
            # Search results — click to navigate to wiki article
            string clickUrl = Wiki.handleSearchClick(searchQuery, pageRelY);
            if (clickUrl.length > 0) {
                navigate(clickUrl);
            }
        }
    }

    # Draw the browser UI
    public static func draw(int x, int y, int w, int h) -> void {
        int charW = TextRender.getCharWidth();
        int charH = TextRender.getCharHeight();

        # Background
        Framebuffer.fillRect(x, y, w, h, 0x0D1117FF);

        # ---- Tab bar ----
        int tabY = y;
        Framebuffer.fillRect(x, tabY, w, BR_TAB_H, 0x080C14FF);

        for (int i = 0; i < browserTabCount; i++) {
            int tx = x + i * BR_TAB_W;
            bool isActive = (i == browserActiveTab);
            color32 tabBg = isActive ? 0x0D1117FF : 0x080C14FF;

            Framebuffer.fillRect(tx, tabY + 4, BR_TAB_W - 2, BR_TAB_H - 4, tabBg);
            if (isActive) {
                Framebuffer.drawHLine(tx, tabY + 4, BR_TAB_W - 2, Theme.textAccent);
            }

            # Tab title
            string tabTitleStr = getTabTitle(i);
            if (tabTitleStr.length > 14) tabTitleStr = tabTitleStr.substring(0, 14);
            color32 tabTextColor = isActive ? 0xE6EDF3FF : 0x6B7280FF;
            TextRender.drawText(tabTitleStr, tx + 8, tabY + 8, tabTextColor);

            # Close button on active tab
            if (isActive && browserTabCount > 1) {
                int closeX = tx + BR_TAB_W - 18;
                int closeY = tabY + BR_TAB_H / 2;
                Framebuffer.drawLine(closeX - 3, closeY - 3, closeX + 3, closeY + 3, 0x6B7280FF);
                Framebuffer.drawLine(closeX + 3, closeY - 3, closeX - 3, closeY + 3, 0x6B7280FF);
            }
        }

        # New tab button (+)
        int plusX = x + browserTabCount * BR_TAB_W + 4;
        Framebuffer.fillRoundedRect(plusX, tabY + 6, 22, 18, 3, 0x1A2332FF);
        TextRender.drawText("+", plusX + 7, tabY + 8, 0x6B7280FF);

        # ---- Toolbar ----
        int toolY = y + BR_TAB_H;
        Framebuffer.fillRect(x, toolY, w, BR_TOOLBAR_H, 0x101824FF);
        Framebuffer.drawHLine(x, toolY + BR_TOOLBAR_H - 1, w, 0x1A2332FF);

        int btnY = toolY + 6;
        # Back button
        Framebuffer.fillRoundedRect(x + 8, btnY, 28, 24, 4, 0x1A2332FF);
        TextRender.drawText("<", x + 18, btnY + 4, 0x8B949EFF);

        # Forward button
        Framebuffer.fillRoundedRect(x + 40, btnY, 28, 24, 4, 0x1A2332FF);
        TextRender.drawText(">", x + 50, btnY + 4, 0x8B949EFF);

        # Reload button
        Framebuffer.fillRoundedRect(x + 72, btnY, 28, 24, 4, 0x1A2332FF);
        TextRender.drawText("R", x + 82, btnY + 4, 0x8B949EFF);

        # URL bar
        int urlX = x + 110;
        int urlW = w - 130;
        color32 urlBorder = browserUrlEditing ? Theme.textAccent : 0x1A2332FF;
        Framebuffer.fillRoundedRect(urlX, btnY, urlW, 24, 12, 0x0A0E1AFF);
        Framebuffer.drawRoundedRect(urlX, btnY, urlW, 24, 12, urlBorder);

        # URL text
        string displayUrl = browserUrlEditing ? browserUrlInput : browserUrl;
        if (displayUrl.length * charW > urlW - 20) {
            int maxChars = (urlW - 20) / charW;
            displayUrl = displayUrl.substring(0, maxChars);
        }
        TextRender.drawText(displayUrl, urlX + 12, btnY + 4, 0xC9D1D9FF);

        # URL editing cursor
        if (browserUrlEditing) {
            int cursorX = urlX + 12 + browserUrlInput.length * charW;
            Framebuffer.fillRect(cursorX, btnY + 4, 2, charH, Theme.textAccent);
        }

        # ---- Bookmark bar ----
        int bmkBarY = y + BR_TAB_H + BR_TOOLBAR_H;
        int bmkBarH = 0;
        if (browserShowBookmarks && bookmarkCount > 0) {
            bmkBarH = BR_BOOKMARK_H;
            Framebuffer.fillRect(x, bmkBarY, w, bmkBarH, 0x101824FF);
            Framebuffer.drawHLine(x, bmkBarY + bmkBarH - 1, w, 0x1A2332FF);

            int bx = x + 8;
            for (int i = 0; i < bookmarkCount; i++) {
                string label = getBmkLabel(i);
                if (label.length > 12) label = label.substring(0, 12);
                int labelW = label.length * charW + 16;
                Framebuffer.fillRoundedRect(bx, bmkBarY + 2, labelW, 18, 4, 0x1A2332FF);
                TextRender.drawText(label, bx + 8, bmkBarY + 3, 0x8B949EFF);
                bx = bx + labelW + 4;
            }
        }

        # ---- Page content ----
        int pageY = bmkBarY + bmkBarH;
        int pageH = h - BR_TAB_H - BR_TOOLBAR_H - bmkBarH;

        # Clip to page area
        Framebuffer.fillRect(x, pageY, w, pageH, 0x0D1117FF);

        if (browserUrl == "stratos://home") {
            drawHomePage(x, pageY, w, pageH);
        } elif (browserUrl == "stratos://about") {
            drawAboutPage(x, pageY, w, pageH);
        } elif (browserUrl == "stratos://help") {
            drawHelpPage(x, pageY, w, pageH);
        } elif (browserUrl == "stratos://settings") {
            drawSettingsPage(x, pageY, w, pageH);
        } elif (browserUrl == "stratos://changelog") {
            drawChangelogPage(x, pageY, w, pageH);
        } elif (browserUrl.indexOf("stratos://search") == 0) {
            Wiki.drawSearchPage(searchQuery, x, pageY, w, pageH, browserScrollY);
        } elif (browserUrl.indexOf("stratos://wiki/") == 0) {
            Wiki.drawArticlePage(currentWikiId, x, pageY, w, pageH, browserScrollY);
        } elif (browserUrl.indexOf("http://") == 0 || browserUrl.indexOf("https://") == 0) {
            drawHttpPage(x, pageY, w, pageH);
        } else {
            drawErrorPage(x, pageY, w, pageH);
        }
    }

    # ========================================================================
    # Internal — Navigation
    # ========================================================================

    private static func navigate(string url) -> void {
        browserUrl = url;
        browserScrollY = 0;
        homeSearchEditing = false;
        homeSearchInput = "";

        # Resolve title from URL
        if (url.indexOf("stratos://search?q=") == 0) {
            searchQuery = Wiki.parseSearchQuery(url);
            browserTitle = "Search";
        } elif (url.indexOf("stratos://wiki/") == 0) {
            currentWikiId = Wiki.parseWikiId(url);
            browserTitle = Wiki.getTitle(currentWikiId);
        } elif (url.indexOf("http://") == 0 || url.indexOf("https://") == 0) {
            browserTitle = "Loading...";
            fetchHttpPage(url);
        } elif (url == "stratos://home") browserTitle = "Home";
        elif (url == "stratos://about") browserTitle = "About";
        elif (url == "stratos://help") browserTitle = "Help";
        elif (url == "stratos://settings") browserTitle = "Browser Settings";
        elif (url == "stratos://changelog") browserTitle = "Changelog";
        else browserTitle = "Not Found";

        # Update tab data
        setTabUrl(browserActiveTab, browserUrl);
        setTabTitle(browserActiveTab, browserTitle);
        setTabScrollY(browserActiveTab, 0);
    }

    private static func handleUrlInput(KeyEvent event) -> void {
        # Escape — cancel
        if (event.scancode == 1) {
            browserUrlEditing = false;
            return;
        }
        # Enter — navigate or search
        if (event.scancode == 28) {
            browserUrlEditing = false;
            if (browserUrlInput.indexOf("stratos://") == 0) {
                navigate(browserUrlInput);
            } elif (browserUrlInput.indexOf("http://") == 0) {
                navigate(browserUrlInput);
            } elif (browserUrlInput.indexOf("https://") == 0) {
                navigate(browserUrlInput);
            } else {
                navigate("stratos://search?q=" + browserUrlInput);
            }
            return;
        }
        # Backspace
        if (event.scancode == 14) {
            if (browserUrlInput.length > 0) {
                browserUrlInput = browserUrlInput.substring(0, browserUrlInput.length - 1);
            }
            return;
        }
        # Printable character
        if (event.ascii >= 32 && event.ascii < 127) {
            browserUrlInput = browserUrlInput + (string) event.ascii;
        }
    }

    # Handle input for home page search bar
    private static func handleHomeSearch(KeyEvent event) -> void {
        # Escape — cancel search
        if (event.scancode == 1) {
            homeSearchEditing = false;
            homeSearchInput = "";
            return;
        }
        # Enter — perform search
        if (event.scancode == 28) {
            homeSearchEditing = false;
            if (homeSearchInput.length > 0) {
                navigate("stratos://search?q=" + homeSearchInput);
            }
            homeSearchInput = "";
            return;
        }
        # Backspace
        if (event.scancode == 14) {
            if (homeSearchInput.length > 0) {
                homeSearchInput = homeSearchInput.substring(0, homeSearchInput.length - 1);
            }
            return;
        }
        # Printable character
        if (event.ascii >= 32 && event.ascii < 127) {
            homeSearchInput = homeSearchInput + (string) event.ascii;
        }
    }

    # ========================================================================
    # Internal — Tab management
    # ========================================================================

    private static func newTab() -> void {
        if (browserTabCount >= 6) return;

        setTabUrl(browserTabCount, "stratos://home");
        setTabTitle(browserTabCount, "Home");
        setTabScrollY(browserTabCount, 0);
        browserTabCount = browserTabCount + 1;
        switchTab(browserTabCount - 1);
        navigate("stratos://home");
    }

    private static func closeTab(int idx) -> void {
        if (browserTabCount <= 1) return;

        # Shift tabs left
        for (int i = idx; i < browserTabCount - 1; i++) {
            setTabUrl(i, getTabUrl(i + 1));
            setTabTitle(i, getTabTitle(i + 1));
            setTabScrollY(i, getTabScrollY(i + 1));
        }
        browserTabCount = browserTabCount - 1;

        if (browserActiveTab >= browserTabCount) {
            browserActiveTab = browserTabCount - 1;
        }
        # Restore active tab state
        browserUrl = getTabUrl(browserActiveTab);
        browserTitle = getTabTitle(browserActiveTab);
        browserScrollY = getTabScrollY(browserActiveTab);
    }

    private static func switchTab(int idx) -> void {
        if (idx < 0 || idx >= browserTabCount) return;

        # Save current tab
        setTabUrl(browserActiveTab, browserUrl);
        setTabTitle(browserActiveTab, browserTitle);
        setTabScrollY(browserActiveTab, browserScrollY);

        # Load new tab
        browserActiveTab = idx;
        browserUrl = getTabUrl(idx);
        browserTitle = getTabTitle(idx);
        browserScrollY = getTabScrollY(idx);
    }

    # Tab data accessors (parallel array switch pattern)
    private static func getTabUrl(int i) -> string {
        switch (i) {
            case 0: return tabUrl0;
            case 1: return tabUrl1;
            case 2: return tabUrl2;
            case 3: return tabUrl3;
            case 4: return tabUrl4;
            case 5: return tabUrl5;
            default: return "";
        }
    }
    private static func setTabUrl(int i, string v) -> void {
        switch (i) {
            case 0: tabUrl0 = v; break;
            case 1: tabUrl1 = v; break;
            case 2: tabUrl2 = v; break;
            case 3: tabUrl3 = v; break;
            case 4: tabUrl4 = v; break;
            case 5: tabUrl5 = v; break;
        }
    }
    private static func getTabTitle(int i) -> string {
        switch (i) {
            case 0: return tabTitle0;
            case 1: return tabTitle1;
            case 2: return tabTitle2;
            case 3: return tabTitle3;
            case 4: return tabTitle4;
            case 5: return tabTitle5;
            default: return "";
        }
    }
    private static func setTabTitle(int i, string v) -> void {
        switch (i) {
            case 0: tabTitle0 = v; break;
            case 1: tabTitle1 = v; break;
            case 2: tabTitle2 = v; break;
            case 3: tabTitle3 = v; break;
            case 4: tabTitle4 = v; break;
            case 5: tabTitle5 = v; break;
        }
    }
    private static func getTabScrollY(int i) -> int {
        switch (i) {
            case 0: return tabScrollY0;
            case 1: return tabScrollY1;
            case 2: return tabScrollY2;
            case 3: return tabScrollY3;
            case 4: return tabScrollY4;
            case 5: return tabScrollY5;
            default: return 0;
        }
    }
    private static func setTabScrollY(int i, int v) -> void {
        switch (i) {
            case 0: tabScrollY0 = v; break;
            case 1: tabScrollY1 = v; break;
            case 2: tabScrollY2 = v; break;
            case 3: tabScrollY3 = v; break;
            case 4: tabScrollY4 = v; break;
            case 5: tabScrollY5 = v; break;
        }
    }

    # ========================================================================
    # Internal — Page renderers
    # ========================================================================

    private static func drawHomePage(int x, int y, int w, int h) -> void {
        int centerX = x + w / 2;
        int scrollOff = browserScrollY;

        # Logo area
        int logoY = y + 80 - scrollOff;
        if (logoY > y - 60 && logoY < y + h) {
            Framebuffer.fillCircle(centerX, logoY, 30, 0x5B8CFF40);
            Framebuffer.fillCircle(centerX, logoY, 20, 0x5B8CFF80);
            Framebuffer.fillCircle(centerX, logoY, 10, 0x5B8CFFFF);
        }

        # Title
        int titleY = logoY + 50;
        if (titleY > y && titleY < y + h) {
            string title = "Void Browser";
            int titleW = title.length * 8;
            TextRender.drawText(title, centerX - titleW / 2, titleY, 0xE6EDF3FF);
        }

        # Subtitle
        int subY = titleY + 24;
        if (subY > y && subY < y + h) {
            string sub = "Search the VoidSearch encyclopedia";
            int subW = sub.length * 8;
            TextRender.drawText(sub, centerX - subW / 2, subY, 0x6B7280FF);
        }

        # Search bar (interactive)
        int searchY = subY + 50;
        if (searchY > y && searchY < y + h) {
            int searchW = 400;
            if (searchW > w - 40) searchW = w - 40;
            int searchX = centerX - searchW / 2;
            int charW2 = TextRender.getCharWidth();
            int charH2 = TextRender.getCharHeight();

            color32 searchBorder = homeSearchEditing ? Theme.textAccent : 0x2A3442FF;
            Framebuffer.fillRoundedRect(searchX, searchY, searchW, 36, 18, 0x1A2332FF);
            Framebuffer.drawRoundedRect(searchX, searchY, searchW, 36, 18, searchBorder);

            if (homeSearchEditing) {
                if (homeSearchInput.length > 0) {
                    TextRender.drawText(homeSearchInput, searchX + 16, searchY + 10, 0xE6EDF3FF);
                    int curX = searchX + 16 + homeSearchInput.length * charW2;
                    Framebuffer.fillRect(curX, searchY + 10, 2, charH2, Theme.textAccent);
                } else {
                    TextRender.drawText("Search VoidSearch...", searchX + 16, searchY + 10, 0x484F58FF);
                    Framebuffer.fillRect(searchX + 16, searchY + 10, 2, charH2, Theme.textAccent);
                }
            } else {
                TextRender.drawText("Search VoidSearch...", searchX + 16, searchY + 10, 0x484F58FF);
            }
        }

        # Quick links
        int linkY = searchY + 70;
        if (linkY > y - 80 && linkY < y + h) {
            int linkW = 100;
            int linkH = 80;
            int gap = 20;
            int totalW = 4 * linkW + 3 * gap;
            int startX = centerX - totalW / 2;

            string link0 = "About";
            string link1 = "Help";
            string link2 = "Settings";
            string link3 = "Changelog";

            color32 colors0 = 0x5B8CFFFF;
            color32 colors1 = 0x69F0AEFF;
            color32 colors2 = 0xFFB74DFF;
            color32 colors3 = 0xBB86FCFF;

            for (int i = 0; i < 4; i++) {
                int lx = startX + i * (linkW + gap);
                color32 lc = colors0;
                string ln = link0;
                if (i == 1) { lc = colors1; ln = link1; }
                elif (i == 2) { lc = colors2; ln = link2; }
                elif (i == 3) { lc = colors3; ln = link3; }

                Framebuffer.fillRoundedRect(lx, linkY, linkW, linkH, 8, 0x1A2332FF);
                Framebuffer.fillCircle(lx + linkW / 2, linkY + 28, 12, lc);
                int lnW = ln.length * 8;
                TextRender.drawText(ln, lx + linkW / 2 - lnW / 2, linkY + linkH - 20, 0xC9D1D9FF);
            }
        }
    }

