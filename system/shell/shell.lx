    private static func cmdMan(list<string> args) -> void {
        if (args.length == 0) {
            Console.log("What manual page do you want?");
            Console.log("Usage: man <command>");
            return;
        }

        string cmd = args[0];

        # Inline manual pages for common commands
        switch (cmd) {
            case "ls":
                Console.log("LS(1) - list directory contents");
                Console.log("");
                Console.log("SYNOPSIS: ls [path] [-l] [-a]");
                Console.log("  List files and directories.");
                Console.log("  -l  Long format with sizes");
                Console.log("  -a  Show hidden files");
                break;
            case "cd":
                Console.log("CD(1) - change working directory");
                Console.log("");
                Console.log("SYNOPSIS: cd [path]");
                Console.log("  Change to the specified directory.");
                Console.log("  Without argument, go to home directory.");
                break;
            case "quantum":
                Console.log("QUANTUM(1) - StratOS Package Manager");
                Console.log("");
                Console.log("SYNOPSIS: quantum <command> [args]");
                Console.log("");
                Console.log("COMMANDS:");
                Console.log("  install <pkg> [--url <url>]  Install a package");
                Console.log("  remove <pkg> [--force]       Remove a package");
                Console.log("  update                       Update registry");
                Console.log("  search <query>               Search packages");
                Console.log("  list                         List installed");
                Console.log("  info <pkg>                   Package details");
                Console.log("  set-url <url>                Set registry URL");
                Console.log("  get-url                      Show registry URL");
                break;
            case "sudo":
                Console.log("SUDO(1) - execute command as root");
                Console.log("");
                Console.log("SYNOPSIS: sudo <command> [args...]");
                Console.log("  Run a command with root privileges.");
                break;
            case "grep":
                Console.log("GREP(1) - search file contents");
                Console.log("");
                Console.log("SYNOPSIS: grep <pattern> <file>");
                Console.log("  Search for lines matching pattern.");
                break;
            case "find":
                Console.log("FIND(1) - search for files");
                Console.log("");
                Console.log("SYNOPSIS: find <path> [-name <pattern>]");
                Console.log("  Search for files in a directory tree.");
                break;
            case "ping":
                Console.log("PING(1) - send ICMP ECHO_REQUEST");
                Console.log("");
                Console.log("SYNOPSIS: ping <host>");
                Console.log("  Send 4 ICMP packets to the specified host.");
                Console.log("  Accepts IP addresses or hostnames (resolved via DNS).");
                break;
            case "ifconfig":
                Console.log("IFCONFIG(1) - configure network interface");
                Console.log("");
                Console.log("SYNOPSIS: ifconfig");
                Console.log("  Display network interface configuration.");
                break;
            case "wget":
                Console.log("WGET(1) - non-interactive network downloader");
                Console.log("");
                Console.log("SYNOPSIS: wget <url>");
                Console.log("  Download a file from the specified HTTP URL.");
                Console.log("  Only http:// URLs are supported.");
                break;
            case "nslookup":
                Console.log("NSLOOKUP(1) - query DNS");
                Console.log("");
                Console.log("SYNOPSIS: nslookup <hostname>");
                Console.log("  Query the DNS server to resolve a hostname.");
                break;
            default:
                Console.log("No manual entry for '${cmd}'");
                break;
        }
    }

