        Console.log("[    0.000012] PIC: Programmable Interrupt Controller configured");
        Console.log("[    0.000013] PIC: IRQ0 (timer), IRQ1 (keyboard) enabled");
        Console.log("[    0.000020] Framebuffer: 1024x768x32bpp initialized");
        Console.log("[    0.000021] Console: text mode 128x48 ready");
