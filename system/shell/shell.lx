    private static func cmdWallpaper(list<string> args) -> void {
        if (args.length == 0) {
            Console.log("wallpaper — Manage desktop wallpapers");
            Console.log("");
            Console.log("Usage:");
            Console.log("  wallpaper list       List available wallpapers");
            Console.log("  wallpaper set <num>  Set wallpaper by number (0-3)");
            Console.log("  wallpaper next       Cycle to next wallpaper");
            Console.log("");
            Console.log("Keyboard shortcut: Ctrl+W (in desktop mode)");
            return;
        }

        string subcmd = args[0];

        if (subcmd == "list") {
            Console.log("Available wallpapers:");
            Console.setColor(HIGHLIGHT_COLOR);
            Console.log("  0  Void       Deep space with star field");
            Console.log("  1  Nebula     Purple/blue nebula clouds");
            Console.log("  2  Aurora     Northern lights over hills");
            Console.log("  3  Mountain   Sunset mountain silhouettes");
            Console.setColor(TEXT_COLOR);
            Console.log("");
            Console.log("Set with: wallpaper set <number>");
        } elif (subcmd == "set") {
            if (args.length < 2) {
                Console.log("wallpaper set: missing wallpaper number (0-3)");
                return;
            }
            int idx = (int) args[1];
            if (idx < 0 || idx > 3) {
                Console.setColor(ERROR_COLOR);
                Console.log("Invalid wallpaper index. Use 0-3.");
                Console.setColor(TEXT_COLOR);
                return;
            }
            Desktop.setWallpaper(idx);
            string names = "Void";
            if (idx == 1) names = "Nebula";
            elif (idx == 2) names = "Aurora";
            elif (idx == 3) names = "Mountain";
            Console.setColor(PROMPT_PATH_COLOR);
            Console.log("Wallpaper set to: $names");
            Console.setColor(TEXT_COLOR);
        } elif (subcmd == "next") {
            Desktop.nextWallpaper();
            Console.setColor(PROMPT_PATH_COLOR);
            Console.log("Switched to next wallpaper.");
            Console.setColor(TEXT_COLOR);
        } else {
            Console.setColor(ERROR_COLOR);
            Console.log("wallpaper: unknown subcommand '$subcmd'");
            Console.setColor(TEXT_COLOR);
        }
    }

    private static func cmdInstall(list<string> args) -> void {
        Console.setColor(HIGHLIGHT_COLOR);
        Console.log("Launching StratOS TUI Installer...");
        Console.setColor(TEXT_COLOR);
        Timer.sleep(300);

        bool success = Installer.run();
        if (success) {
            # Update shell state from installer config
            username = instUsername;
            hostname = instHostname;
            currentDir = "/home/${instUsername}";
            setEnv("HOME", "/home/${instUsername}");
            setEnv("USER", instUsername);
            setEnv("HOSTNAME", instHostname);

            Console.setColor(PROMPT_PATH_COLOR);
            Console.log("Installation complete! Shell updated with new configuration.");
            Console.setColor(TEXT_COLOR);
        } else {
            Console.setColor(ERROR_COLOR);
            Console.log("Installation cancelled.");
            Console.setColor(TEXT_COLOR);
        }
    }

    # Pipe execution (simplified)
    private static func executePipeline(string input) -> void {
        Console.log("pipe: pipeline execution not yet implemented");
    }

    # ========================================================================
    # ========================================================================
    # Compile & Run Commands
    # ========================================================================

    # cc — compile a C++ source file to an ELF binary
    # Usage: cc <source.cpp> [-o output]
    private static func cmdCc(list<string> args) -> void {
        if (args.length == 0) {
            Console.setColor(HIGHLIGHT_COLOR);
            Console.log("cc - StratOS C++ Compiler (Clang)");
            Console.setColor(TEXT_COLOR);
            Console.log("");
            Console.log("  Usage: cc <source.cpp> [-o output]");
            Console.log("         cc <source.flux> [-o output]   (Flux → C++ → ELF)");
            Console.log("");
            Console.log("  Options:");
            Console.log("    -o <file>    Set output binary name");
            Console.log("    --trusted    Run compiler in Ring 0 (default)");
            Console.log("");
            return;
        }

        string source = "";
        string output = "";
        bool trusted = true;  # Compiler always runs in Ring 0

        for (int i = 0; i < args.length; i++) {
            if (args[i] == "-o" && (i + 1) < args.length) {
                output = args[i + 1];
                i++;
            } elif (args[i] == "--trusted") {
                trusted = true;
            } elif (!args[i].startsWith("-")) {
                source = args[i];
            }
        }

        if (source == "") {
            Console.setColor(ERROR_COLOR);
            Console.log("cc: no input file");
            Console.setColor(TEXT_COLOR);
            return;
        }

        # Resolve source path
        string srcPath = resolvePath(source);

        if (!VFS.isFile(srcPath)) {
            Console.setColor(ERROR_COLOR);
            Console.log("cc: ${source}: No such file");
            Console.setColor(TEXT_COLOR);
            return;
        }

        # Determine output name if not specified
        if (output == "") {
            if (srcPath.endsWith(".cpp") || srcPath.endsWith(".cc") || srcPath.endsWith(".c")) {
                # Strip extension for output name
                int dotIdx = srcPath.lastIndexOf(".");
                if (dotIdx >= 0) {
                    output = srcPath.substring(0, dotIdx);
                } else {
                    output = srcPath + ".elf";
                }
            } elif (srcPath.endsWith(".flux") || srcPath.endsWith(".lx")) {
                int dotIdx = srcPath.lastIndexOf(".");
                if (dotIdx >= 0) {
                    output = srcPath.substring(0, dotIdx);
                } else {
                    output = srcPath + ".elf";
                }
            } else {
                output = srcPath + ".elf";
            }
        } else {
            output = resolvePath(output);
        }

        # Check if this is a Flux file — needs transpile first
        if (srcPath.endsWith(".flux") || srcPath.endsWith(".lx")) {
            Console.setColor(PROMPT_PATH_COLOR);
            Console.log("[CC] Transpiling Flux → C++: ${source}");
            Console.setColor(TEXT_COLOR);

            ProcessExec.runFlux(srcPath, trusted);
            return;
        }

        # C++ file — compile directly
        Console.setColor(PROMPT_PATH_COLOR);
        Console.log("[CC] Compiling: ${source} → ${output}");
        Console.setColor(TEXT_COLOR);

        ProcessExec.compileAndRun(srcPath, output, trusted);
    }

    # run — execute an ELF binary
    # Usage: run <binary> [--trusted]
    private static func cmdRunElf(list<string> args) -> void {
        if (args.length == 0) {
            Console.setColor(HIGHLIGHT_COLOR);
            Console.log("run - Execute an ELF binary");
            Console.setColor(TEXT_COLOR);
            Console.log("");
            Console.log("  Usage: run <binary> [--trusted]");
            Console.log("");
            Console.log("  Options:");
            Console.log("    --trusted    Run in Ring 0 (kernel space)");
            Console.log("                 Default: Ring 3 (user space)");
            Console.log("");
            return;
        }

        string binary = "";
        bool trusted = false;  # User programs run in Ring 3 by default

        for (int i = 0; i < args.length; i++) {
            if (args[i] == "--trusted") {
                if (!isRoot) {
                    Console.setColor(ERROR_COLOR);
                    Console.log("run: --trusted requires root privileges (use sudo)");
                    Console.setColor(TEXT_COLOR);
                    return;
                }
                trusted = true;
            } elif (!args[i].startsWith("-")) {
                binary = args[i];
            }
        }

        if (binary == "") {
            Console.setColor(ERROR_COLOR);
            Console.log("run: no binary specified");
            Console.setColor(TEXT_COLOR);
            return;
        }

        # Resolve binary path
        string binPath = resolvePath(binary);

        if (!VFS.isFile(binPath)) {
            Console.setColor(ERROR_COLOR);
            Console.log("run: ${binary}: No such file");
            Console.setColor(TEXT_COLOR);
            return;
        }

        Console.setColor(PROMPT_PATH_COLOR);
        if (trusted) {
            Console.log("[RUN] Executing (Ring 0): ${binary}");
        } else {
            Console.log("[RUN] Executing (Ring 3): ${binary}");
        }
        Console.setColor(TEXT_COLOR);

        ProcessExec.execute(binPath, trusted);
    }

    # ========================================================================
    # Path Resolution Helper
    # ========================================================================

    private static func resolvePath(string arg) -> string {
        if (arg.startsWith("/")) {
            return VFS.normalizePath(arg);
        }
        return VFS.resolvePath(currentDir, arg);
    }

    # ========================================================================
    # Environment Variable Helpers
    # ========================================================================

    public static func setEnv(string key, string value) -> void {
        for (int i = 0; i < envKeys.length; i++) {
            if (envKeys[i] == key) {
                envValues[i] = value;
                return;
            }
        }
        envKeys.add(key);
        envValues.add(value);
    }

    public static func getEnv(string key) -> string {
        for (int i = 0; i < envKeys.length; i++) {
            if (envKeys[i] == key) {
                return envValues[i];
            }
        }
        return "";
    }

    # Get current working directory
    public static func getCurrentDir() -> string {
        return currentDir;
    }

    # ========================================================================
    # sync — flush VFS contents to disk
    # ========================================================================
    private static func cmdSync(list<string> args) -> void {
        if (!VFS.isPersistent()) {
            Console.setColor(HIGHLIGHT_COLOR);
            Console.log("sync: no persistent storage available");
            Console.setColor(TEXT_COLOR);
            return;
        }
        Console.log("Syncing filesystem to disk...");
        VFS.markDirty();
        VFS.sync();
        Console.setColor(PROMPT_PATH_COLOR);
        Console.log("Sync complete.");
        Console.setColor(TEXT_COLOR);
    }

    # ========================================================================
    # Network Commands
    # ========================================================================

    private static func cmdIfconfig(list<string> args) -> void {
        if (!E1000.isPresent()) {
            Console.log("ifconfig: no network interface found");
            return;
        }

        Console.setColor(PROMPT_PATH_COLOR);
        Console.log("eth0:");
        Console.setColor(TEXT_COLOR);

        if (Net.isConfigured()) {
            Console.log("  inet ${Net.getIPString()}");
        } else {
            Console.log("  inet (not configured)");
        }

        # MAC address
        int m0 = E1000.getMac(0);
        int m1 = E1000.getMac(1);
        int m2 = E1000.getMac(2);
        int m3 = E1000.getMac(3);
        int m4 = E1000.getMac(4);
        int m5 = E1000.getMac(5);
        Console.log("  ether ${hexByte(m0)}:${hexByte(m1)}:${hexByte(m2)}:${hexByte(m3)}:${hexByte(m4)}:${hexByte(m5)}");

        Console.log("  status: UP");
        Console.log("  mtu: 1500");
    }

    private static func cmdWget(list<string> args) -> void {
        if (args.length == 0) {
            Console.log("wget: usage: wget <url>");
            return;
        }

        if (!E1000.isPresent() || !Net.isConfigured()) {
            Console.setColor(HIGHLIGHT_COLOR);
            Console.log("wget: network not available");
            Console.setColor(TEXT_COLOR);
            return;
        }

        string url = args[0];

        # Parse URL: http://host/path
        if (!url.startsWith("http://")) {
            Console.log("wget: only http:// URLs supported");
            return;
        }

        string rest = url.substring(7, url.length);
        int slashIdx = -1;
        for (int i = 0; i < rest.length; i++) {
            if (rest.charAt(i) == '/') {
                slashIdx = i;
                break;
            }
        }

        string host = rest;
        string path = "/";
        if (slashIdx >= 0) {
            host = rest.substring(0, slashIdx);
            path = rest.substring(slashIdx, rest.length);
        }

        Console.log("Resolving ${host}...");
        int ip = Net.dnsResolve(host);
        if (ip == 0) {
            # Try parsing as IP
            ip = parseIPAddress(host);
        }
        if (ip == 0) {
            Console.log("wget: unable to resolve host '${host}'");
            return;
        }

        string ipStr = ipToStrShell(ip);
        Console.log("Connecting to ${host} (${ipStr}):80...");

        if (!Net.tcpConnect(ip, 80)) {
            Console.log("wget: connection to ${host}:80 failed");
            return;
        }

        Console.log("Connected.");

        # Build HTTP GET request
        string request = "GET ${path} HTTP/1.0\r\nHost: ${host}\r\nConnection: close\r\n\r\n";
        long reqAddr = MemoryManager.kmalloc(512);
        if (reqAddr == 0) {
            Console.log("wget: out of memory");
            Net.tcpClose();
            return;
        }

        unsafe {
            byte* dst = (byte*) reqAddr;
            long srcAddr = (long) request.c_str();
            byte* src = (byte*) srcAddr;
            for (int i = 0; i < request.length; i++) {
                dst[i] = src[i];
            }
        }

        Net.tcpSend(reqAddr, request.length);

        # Receive response
        long recvBuf = MemoryManager.kmalloc(32768);
        int totalRecv = 0;

        if (recvBuf != 0) {
            int chunk = Net.tcpReceive(recvBuf, 32768, 10000);
            totalRecv = chunk;
        }

        Net.tcpClose();

        if (totalRecv > 0) {
            # Find the filename from path
            string filename = "index.html";
            int lastSlash = -1;
            for (int i = 0; i < path.length; i++) {
                if (path.charAt(i) == '/') lastSlash = i;
            }
            if (lastSlash >= 0 && lastSlash < path.length - 1) {
                filename = path.substring(lastSlash + 1, path.length);
            }

            # Save to current directory
            string savePath = resolvePath(filename);

            # Convert received bytes to string (truncate at reasonable size)
            string content = "";
            unsafe {
                byte* data = (byte*) recvBuf;
                for (int i = 0; i < totalRecv && i < 16384; i++) {
                    string ch = "${(char) data[i]}";
                    content = content + ch;
                }
            }

            VFS.write(savePath, content);
            Console.log("Saved to '${filename}' (${totalRecv} bytes)");
        } else {
            Console.log("wget: no data received");
        }
    }

    private static func cmdNslookup(list<string> args) -> void {
        if (args.length == 0) {
            Console.log("nslookup: usage: nslookup <hostname>");
            return;
        }

        if (!E1000.isPresent() || !Net.isConfigured()) {
            Console.setColor(HIGHLIGHT_COLOR);
            Console.log("nslookup: network not available");
            Console.setColor(TEXT_COLOR);
            return;
        }

        string host = args[0];
        Console.log("Server:  ${Net.getIPString()}");
        Console.log("");

        int ip = Net.dnsResolve(host);
        if (ip == 0) {
            Console.log("** server can't find ${host}: NXDOMAIN");
        } else {
            Console.log("Name:    ${host}");
            Console.log("Address: ${ipToStrShell(ip)}");
        }
    }

    # ========================================================================
    # Network Utility Functions
    # ========================================================================

    private static func parseIPAddress(string ip) -> int {
        # Parse dotted decimal: a.b.c.d
        int result = 0;
        int octet = 0;
        int count = 0;

        for (int i = 0; i <= ip.length; i++) {
            if (i == ip.length || ip.charAt(i) == '.') {
                result = (result << 8) | (octet & 0xFF);
                octet = 0;
                count++;
            } else {
                int ch = (int) ip.charAt(i);
                if (ch >= 48 && ch <= 57) {
                    octet = octet * 10 + (ch - 48);
                } else {
                    return 0;
                }
            }
        }

        if (count != 4) return 0;
        return result;
    }

    private static func ipToStrShell(int ip) -> string {
        int a = (ip >> 24) & 0xFF;
        int b = (ip >> 16) & 0xFF;
        int c = (ip >> 8) & 0xFF;
        int d = ip & 0xFF;
        return "${a}.${b}.${c}.${d}";
    }

    private static func hexByte(int val) -> string {
        string hex = "0123456789abcdef";
        int hi = (val >> 4) & 0x0F;
        int lo = val & 0x0F;
        string h = "${hex.charAt(hi)}";
        string l = "${hex.charAt(lo)}";
        return "${h}${l}";
    }
}
