        Console.log("Starting Stellar Desktop Environment...");
        Console.setColor(TEXT_COLOR);
        Console.log("  Compositor: Stellar v0.1.0");
        Console.log("  Theme:      Clean Cosmic");
        Console.log("  Resolution: 1024x768x32");
