    private static func cmdKill(list<string> args) -> void {
        if (args.length == 0) {
            Console.log("kill: missing PID");
            return;
        }
        int pid = (int) args[0];
        if (pid == 0) {
            Console.setColor(ERROR_COLOR);
            Console.log("kill: cannot kill kernel process");
            Console.setColor(TEXT_COLOR);
        } else {
            Scheduler.terminateProcess(pid);
            Console.log("Terminated process $pid");
        }
    }

