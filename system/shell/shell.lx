// DOCTYPE {AOT}
// ============================================================================
// Shell - Bash-like terminal for StratOS
// system/shell/shell.lx
//
// Features:
//   - Command parsing and execution
//   - Built-in commands (cd, ls, cat, echo, clear, etc.)
//   - Environment variables
//   - Command history
//   - Pipe support (|)
//   - Flux REPL mode (via `flux` command)
//   - Tab completion
// ============================================================================

import "kernel/drivers/keyboard.lx";
import "kernel/drivers/framebuffer.lx";
import "kernel/core/console.lx";
import "kernel/core/scheduler.lx";
import "system/fs/vfs.lx";
import "system/windowing/desktop.lx";
import "system/installer/installer.lx";
import "kernel/core/process.lx";
import "kernel/drivers/e1000.lx";
import "kernel/drivers/net.lx";

# Shell state
string currentDir = "/";
string hostname = "stratos";
string username = "void";
list<string> commandHistory = [];
int historyIndex = -1;
int MAX_HISTORY = 50;
bool isRoot = false;

# Desktop launch flag — set by 'startx', checked by kernel_main
bool desktopRequested = false;

# Quantum package manager config
string quantumRegistryUrl = "stratos.skinnertopia.com";


# Environment variables
list<string> envKeys = [];
list<string> envValues = [];

# Color scheme (clean cosmic)
color32 PROMPT_USER_COLOR = 0x5B8CFFFF;    # Cosmic blue
color32 PROMPT_PATH_COLOR = 0x69F0AEFF;    # Nebula green
color32 PROMPT_SYMBOL_COLOR = 0xC8D0E0FF;  # Silver
color32 TEXT_COLOR = 0xC8D0E0FF;           # Silver-blue
color32 ERROR_COLOR = 0xFF5252FF;          # Alert red
color32 HIGHLIGHT_COLOR = 0xFFB74DFF;      # Amber

# Built-in command names
list<string> builtinCommands = [
    "cd", "ls", "pwd", "echo", "clear", "cat", "mkdir", "rm", "cp", "mv",
    "touch", "history", "export", "env", "whoami", "hostname", "uname",
    "help", "exit", "reboot", "shutdown", "flux", "quantum", "ps", "kill",
    "date", "uptime", "free", "df", "neofetch", "sudo", "su", "ping",
    "head", "wc", "write", "id", "chmod", "chown", "grep", "find",
    "which", "alias", "man", "dmesg", "startx", "wallpaper", "install",
    "cc", "run", "sync", "ifconfig", "wget", "nslookup"
];

export class Shell {
    # Initialize the shell
    public static func init() -> void {
        # Set default environment
        setEnv("HOME", "/home/void");
        setEnv("PATH", "/bin:/usr/bin:/system/bin");
        setEnv("SHELL", "/system/shell/shell");
        setEnv("TERM", "stratos-256color");
        setEnv("USER", username);
        setEnv("HOSTNAME", hostname);
        setEnv("PS1", "\\u@\\h \\w $ ");
        setEnv("EDITOR", "nova");
        setEnv("LANG", "en_US.UTF-8");
        setEnv("STRATOS_VERSION", "0.1.0");

        currentDir = "/home/void";
    }

    # Set the working directory from external callers (e.g. "Open in Terminal")
    public static func setCwd(string path) -> void {
        currentDir = path;
    }

    # Get the current working directory
    public static func getCwd() -> string {
        return currentDir;
    }

    # Main shell loop
    public static func run() -> void {
        # Display welcome message
        Console.setColor(PROMPT_USER_COLOR);
        Console.log("");
        Console.log("  Welcome to StratOS Shell");
        Console.log("  Type 'help' for available commands");
        Console.log("  Type 'flux' to enter the Flux REPL");
        Console.log("");
        Console.setColor(TEXT_COLOR);

        # Main input loop
        while (true) {
            # Check if startx was requested
            if (desktopRequested) {
                return;
            }

            printPrompt();
            string input = readInput();

            if (input.trim().length == 0) continue;

            # Add to history
            if (commandHistory.length >= MAX_HISTORY) {
                commandHistory.removeAt(0);
            }
            commandHistory.add(input);
            historyIndex = commandHistory.length;

            # Parse and execute
            executeCommand(input);
        }
    }

    # Print the shell prompt
    private static func printPrompt() -> void {
        if (isRoot) {
            Console.setColor(ERROR_COLOR);
            Console.write("root@$hostname");
        } else {
            Console.setColor(PROMPT_USER_COLOR);
            Console.write("$username@$hostname");
        }
        Console.setColor(PROMPT_SYMBOL_COLOR);
        Console.write(":");
        Console.setColor(PROMPT_PATH_COLOR);
        Console.write(shortenPath(currentDir));
        Console.setColor(PROMPT_SYMBOL_COLOR);
        if (isRoot) {
            Console.write("# ");
        } else {
            Console.write("$ ");
        }
        Console.setColor(TEXT_COLOR);
    }

    # Shorten home dir to ~
    private static func shortenPath(string path) -> string {
        string home = getEnv("HOME");
        if (path.startsWith(home)) {
            return "~" + path.substring(home.length, path.length - home.length);
        }
        return path;
    }

    # Read input with history navigation and editing
    private static func readInput() -> string {
        string line = "";
        int cursorPos = 0;

        while (true) {
            if (!Keyboard.hasKey()) continue;

            KeyEvent event = Keyboard.pollKey();
            if (!event.pressed) continue;

            # Enter - submit command
            if (event.scancode == KEY_ENTER) {
                Console.log("");  # Newline
                return line;
            }

            # Backspace
            if (event.scancode == KEY_BACKSPACE && cursorPos > 0) {
                line = line.substring(0, cursorPos - 1) + line.substring(cursorPos, line.length - cursorPos);
                cursorPos--;
                redrawInput(line, cursorPos);
                continue;
            }

            # Arrow Up - history previous
            if (event.scancode == KEY_UP && commandHistory.length > 0) {
                if (historyIndex > 0) {
                    historyIndex--;
                }
                if (historyIndex >= 0 && historyIndex < commandHistory.length) {
                    line = commandHistory[historyIndex];
                    cursorPos = line.length;
                    redrawInput(line, cursorPos);
                }
                continue;
            }

            # Arrow Down - history next
            if (event.scancode == KEY_DOWN) {
                if (historyIndex < commandHistory.length - 1) {
                    historyIndex++;
                    if (historyIndex >= 0 && historyIndex < commandHistory.length) {
                        line = commandHistory[historyIndex];
                    }
                } else {
                    historyIndex = commandHistory.length;
                    line = "";
                }
                cursorPos = line.length;
                redrawInput(line, cursorPos);
                continue;
            }

            # Arrow Left
            if (event.scancode == KEY_LEFT && cursorPos > 0) {
                cursorPos--;
                continue;
            }

            # Arrow Right
            if (event.scancode == KEY_RIGHT && cursorPos < line.length) {
                cursorPos++;
                continue;
            }

            # Tab - autocomplete
            if (event.scancode == KEY_TAB) {
                string completed = tabComplete(line);
                if (completed.length > 0) {
                    line = completed;
                    cursorPos = line.length;
                    redrawInput(line, cursorPos);
                }
                continue;
            }

            # Ctrl+C - cancel current line
            if (event.ctrl && event.ascii == 'c') {
                Console.log("^C");
                return "";
            }

            # Ctrl+L - clear screen
            if (event.ctrl && event.ascii == 'l') {
                Framebuffer.clear(0x0A0E1AFF);
                Console.setCursor(0, 0);
                printPrompt();
                Console.write(line);
                continue;
            }

            # PageUp - scroll terminal output up
            if (event.scancode == KEY_PAGEUP) {
                Console.scrollPageUp();
                continue;
            }

            # PageDown - scroll terminal output down
            if (event.scancode == KEY_PAGEDOWN) {
                Console.scrollPageDown();
                continue;
            }

            # Any other key exits scroll mode if active
            if (Console.isScrollMode()) {
                Console.scrollToBottom();
                printPrompt();
                Console.write(line);
            }

            # Regular character
            if (event.ascii >= 32 && event.ascii <= 126) {
                line = line.substring(0, cursorPos) + (string) event.ascii + line.substring(cursorPos, line.length - cursorPos);
                cursorPos++;
                if (cursorPos < line.length) {
                    # Inserting in middle - redraw entire line
                    redrawInput(line, cursorPos);
                } else {
                    # Appending at end - just write the char
                    Console.write((string) event.ascii);
                }
            }
        }
    }

    # Redraw current input line
    private static func redrawInput(string line, int cursor) -> void {
        # Move to start of line
        Console.write("\r");
        # Re-render prompt + full line
        printPrompt();
        Console.write(line);
        # Clear trailing characters from previous (longer) line
        # Use enough spaces to cover any reasonable deletion
        Console.write("                    ");
        # Reposition cursor at the correct column
        Console.write("\r");
        printPrompt();
        if (cursor > 0) {
            Console.write(line.substring(0, cursor));
        }
    }

    # Tab completion
    private static func tabComplete(string partial) -> string {
        list<string> matches = [];

        # Check built-in commands
        for (string cmd in builtinCommands) {
            if (cmd.startsWith(partial)) {
                matches.add(cmd);
            }
        }

        if (matches.length == 1) {
            return matches[0] + " ";
        } elif (matches.length > 1) {
            Console.log("");
            for (string m in matches) {
                Console.write(m + "  ");
            }
            Console.log("");
            return partial;
        }

        return "";
    }

    # Parse and execute a command string
    public static func executeCommand(string input) -> void {
        # Handle pipes
        if (input.contains("|")) {
            executePipeline(input);
            return;
        }

        # Split into command and arguments
        list<string> parts = input.trim().split(" ");
        if (parts.length == 0) return;

        string command = parts[0];
        list<string> args = [];
        for (int i = 1; i < parts.length; i++) {
            args.add(parts[i]);
        }

        # Execute built-in or external command
        switch (command) {
            case "cd":       cmdCd(args); break;
            case "ls":       cmdLs(args); break;
            case "pwd":      cmdPwd(args); break;
            case "echo":     cmdEcho(args); break;
            case "clear":    cmdClear(args); break;
            case "cat":      cmdCat(args); break;
            case "mkdir":    cmdMkdir(args); break;
            case "rm":       cmdRm(args); break;
            case "touch":    cmdTouch(args); break;
            case "history":  cmdHistory(args); break;
            case "export":   cmdExport(args); break;
            case "env":      cmdEnv(args); break;
            case "whoami":   cmdWhoami(args); break;
            case "hostname": cmdHostname(args); break;
            case "uname":    cmdUname(args); break;
            case "help":     cmdHelp(args); break;
            case "exit":     cmdExit(args); break;
            case "reboot":   cmdReboot(args); break;
            case "shutdown": cmdShutdown(args); break;
            case "flux":     cmdFlux(args); break;
            case "quantum":  cmdQuantum(args); break;
            case "ps":       cmdPs(args); break;
            case "kill":     cmdKill(args); break;
            case "date":     cmdDate(args); break;
            case "uptime":   cmdUptime(args); break;
            case "free":     cmdFree(args); break;
            case "neofetch": cmdNeofetch(args); break;
            case "cp":       cmdCp(args); break;
            case "mv":       cmdMv(args); break;
            case "df":       cmdDf(args); break;
            case "write":    cmdWrite(args); break;
            case "head":     cmdHead(args); break;
            case "wc":       cmdWc(args); break;
            case "sudo":     cmdSudo(args); break;
            case "su":       cmdSu(args); break;
            case "ping":     cmdPing(args); break;
            case "id":       cmdId(args); break;
            case "chmod":    cmdChmod(args); break;
            case "chown":    cmdChown(args); break;
            case "grep":     cmdGrep(args); break;
            case "find":     cmdFind(args); break;
            case "which":    cmdWhich(args); break;
            case "man":      cmdMan(args); break;
            case "dmesg":    cmdDmesg(args); break;
            case "startx":   cmdStartx(args); break;
            case "wallpaper": cmdWallpaper(args); break;
            case "install":  cmdInstall(args); break;
            case "cc":       cmdCc(args); break;
            case "run":      cmdRunElf(args); break;
            case "sync":     cmdSync(args); break;
            case "ifconfig": cmdIfconfig(args); break;
            case "wget":     cmdWget(args); break;
            case "nslookup": cmdNslookup(args); break;

            default:
                Console.setColor(ERROR_COLOR);
                Console.log("$command: command not found");
                Console.setColor(TEXT_COLOR);
                break;
        }
    }

    # ========================================================================
    # Built-in Command Implementations
    # ========================================================================

    private static func cmdCd(list<string> args) -> void {
        if (args.length == 0) {
            currentDir = getEnv("HOME");
            return;
        }

        string target = args[0];
        string resolved = "";

        if (target == "-") {
            resolved = getEnv("OLDPWD");
            if (resolved == "") resolved = currentDir;
        } elif (target == "~") {
            resolved = getEnv("HOME");
        } elif (target == "..") {
            resolved = VFS.parentPath(currentDir);
        } elif (target == "/") {
            resolved = "/";
        } elif (target.startsWith("/")) {
            resolved = VFS.normalizePath(target);
        } else {
            resolved = VFS.resolvePath(currentDir, target);
        }

        if (!VFS.isDirectory(resolved)) {
            Console.setColor(ERROR_COLOR);
            Console.log("cd: ${target}: No such directory");
            Console.setColor(TEXT_COLOR);
            return;
        }

        setEnv("OLDPWD", currentDir);
        currentDir = resolved;
    }

    private static func cmdLs(list<string> args) -> void {
        string path = currentDir;
        bool showLong = false;
        bool showAll = false;

        for (string a in args) {
            if (a == "-l") {
                showLong = true;
            } elif (a == "-a") {
                showAll = true;
            } elif (a == "-la" || a == "-al") {
                showLong = true;
                showAll = true;
            } elif (!a.startsWith("-")) {
                if (a.startsWith("/")) {
                    path = VFS.normalizePath(a);
                } else {
                    path = VFS.resolvePath(currentDir, a);
                }
            }
        }

        if (!VFS.isDirectory(path)) {
            if (VFS.isFile(path)) {
                Console.log(VFS.basename(path));
                return;
            }
            Console.setColor(ERROR_COLOR);
            Console.log("ls: cannot access '${path}': No such file or directory");
            Console.setColor(TEXT_COLOR);
            return;
        }

        list<FileInfo> entries = VFS.listDir(path);

        if (entries.length == 0) {
            return;
        }

        if (showLong) {
            for (FileInfo fi in entries) {
                if (!showAll && fi.name.startsWith(".")) continue;

                string typeChar = "-";
                if (fi.type == 1) typeChar = "d";

                string sizeStr = "${fi.size}";
                while (sizeStr.length < 8) sizeStr = " " + sizeStr;

                if (fi.type == 1) {
                    Console.setColor(PROMPT_PATH_COLOR);
                } else {
                    Console.setColor(TEXT_COLOR);
                }
                Console.log("${typeChar} ${fi.permissions}  ${fi.owner}  ${sizeStr}  ${fi.name}");
            }
            Console.setColor(TEXT_COLOR);
        } else {
            string line = "";
            int count = 0;
            for (FileInfo fi in entries) {
                if (!showAll && fi.name.startsWith(".")) continue;

                string name = fi.name;
                if (fi.type == 1) name = name + "/";

                if (fi.type == 1) {
                    if (line.length > 0) {
                        Console.setColor(TEXT_COLOR);
                        Console.write(line);
                        line = "";
                    }
                    Console.setColor(PROMPT_PATH_COLOR);
                    Console.write(name + "  ");
                } else {
                    line += name + "  ";
                }
                count++;
            }
            if (line.length > 0) {
                Console.setColor(TEXT_COLOR);
                Console.write(line);
            }
            if (count > 0) Console.log("");
            Console.setColor(TEXT_COLOR);
        }
    }

    private static func cmdPwd(list<string> args) -> void {
        Console.log(currentDir);
    }

    private static func cmdEcho(list<string> args) -> void {
        string output = "";
        for (int i = 0; i < args.length; i++) {
            string arg = args[i];
            # Expand environment variables ($VAR)
            if (arg.startsWith("$")) {
                string varName = arg.substring(1, arg.length - 1);
                string val = getEnv(varName);
                output += val;
            } else {
                output += arg;
            }
            if (i < args.length - 1) output += " ";
        }
        Console.log(output);
    }

    private static func cmdClear(list<string> args) -> void {
        Framebuffer.clear(0x0A0E1AFF);
        Console.setCursor(0, 0);
    }

    private static func cmdCat(list<string> args) -> void {
        if (args.length == 0) {
            Console.log("cat: missing operand");
            return;
        }

        for (string arg in args) {
            string path = "";
            if (arg.startsWith("/")) {
                path = VFS.normalizePath(arg);
            } else {
                path = VFS.resolvePath(currentDir, arg);
            }

            if (!VFS.exists(path)) {
                Console.setColor(ERROR_COLOR);
                Console.log("cat: ${arg}: No such file or directory");
                Console.setColor(TEXT_COLOR);
                continue;
            }

            if (VFS.isDirectory(path)) {
                Console.setColor(ERROR_COLOR);
                Console.log("cat: ${arg}: Is a directory");
                Console.setColor(TEXT_COLOR);
                continue;
            }

            string content = VFS.read(path);
            if (content.length > 0) {
                Console.log(content);
            }
        }
    }

    private static func cmdMkdir(list<string> args) -> void {
        if (args.length == 0) {
            Console.log("mkdir: missing operand");
            return;
        }

        bool recursive = false;
        for (string a in args) {
            if (a == "-p") {
                recursive = true;
            }
        }

        for (string a in args) {
            if (a.startsWith("-")) continue;

            string path = "";
            if (a.startsWith("/")) {
                path = VFS.normalizePath(a);
            } else {
                path = VFS.resolvePath(currentDir, a);
            }

            bool ok = false;
            if (recursive) {
                ok = VFS.mkdirp(path);
            } else {
                # Check parent exists
                string parent = VFS.parentPath(path);
                if (!VFS.isDirectory(parent)) {
                    Console.setColor(ERROR_COLOR);
                    Console.log("mkdir: cannot create '${a}': No such file or directory");
                    Console.setColor(TEXT_COLOR);
                    continue;
                }
                ok = VFS.mkdir(path);
            }

            if (!ok) {
                Console.setColor(ERROR_COLOR);
                Console.log("mkdir: cannot create '${a}': File exists");
                Console.setColor(TEXT_COLOR);
            }
        }
    }

    private static func cmdRm(list<string> args) -> void {
        if (args.length == 0) {
            Console.log("rm: missing operand");
            return;
        }

        bool recursive = false;
        bool force = false;
        bool noPreserveRoot = false;
        for (string a in args) {
            if (a == "-r" || a == "-rf" || a == "-fr") {
                recursive = true;
                force = true;
            } elif (a == "-f") {
                force = true;
            } elif (a == "--no-preserve-root") {
                noPreserveRoot = true;
            }
        }

        for (string a in args) {
            if (a.startsWith("-")) continue;

            string path = "";
            if (a.startsWith("/")) {
                path = VFS.normalizePath(a);
            } else {
                path = VFS.resolvePath(currentDir, a);
            }

            # Root protection
            if (path == "/") {
                if (!recursive || !noPreserveRoot) {
                    Console.setColor(ERROR_COLOR);
                    Console.log("rm: it is dangerous to operate recursively on '/'");
                    Console.log("rm: use --no-preserve-root to override this failsafe");
                    Console.setColor(TEXT_COLOR);
                    continue;
                }

                if (!isRoot) {
                    Console.setColor(ERROR_COLOR);
                    Console.log("rm: permission denied (must be root)");
                    Console.setColor(TEXT_COLOR);
                    continue;
                }

                # The legendary rm -rf / --no-preserve-root
                Console.setColor(ERROR_COLOR);
                Console.log("");
                Console.log("    Deleting everything...");
                Console.log("");

                long start = Timer.getElapsedMs();
                while (Timer.getElapsedMs() - start < 500) {}

                VFS.removeRecursive("/");

                Console.log("    Everything is gone. Are you happy now?");
                Console.log("");
                Console.log("    Filesystem destroyed. Nothing left.");
                Console.log("    You monster.");
                Console.log("");
                Console.setColor(TEXT_COLOR);
                continue;
            }

            if (!VFS.exists(path)) {
                if (!force) {
                    Console.setColor(ERROR_COLOR);
                    Console.log("rm: cannot remove '${a}': No such file or directory");
                    Console.setColor(TEXT_COLOR);
                }
                continue;
            }

            if (VFS.isDirectory(path)) {
                if (!recursive) {
                    Console.setColor(ERROR_COLOR);
                    Console.log("rm: cannot remove '${a}': Is a directory (use -r)");
                    Console.setColor(TEXT_COLOR);
                    continue;
                }
                VFS.removeRecursive(path);
            } else {
                VFS.remove(path);
            }
        }
    }

    private static func cmdTouch(list<string> args) -> void {
        if (args.length == 0) {
            Console.log("touch: missing file operand");
            return;
        }

        for (string a in args) {
            string path = "";
            if (a.startsWith("/")) {
                path = VFS.normalizePath(a);
            } else {
                path = VFS.resolvePath(currentDir, a);
            }

            # Check parent directory exists
            string parent = VFS.parentPath(path);
            if (!VFS.isDirectory(parent)) {
                Console.setColor(ERROR_COLOR);
                Console.log("touch: cannot touch '${a}': No such file or directory");
                Console.setColor(TEXT_COLOR);
                continue;
            }

            if (!VFS.exists(path)) {
                VFS.touch(path);
            }
            # If file already exists, touch just updates timestamp (no-op for RAM FS)
        }
    }

    private static func cmdCp(list<string> args) -> void {
        if (args.length < 2) {
            Console.log("cp: missing operand");
            Console.log("Usage: cp <source> <destination>");
            return;
        }

        bool recursive = false;
        list<string> paths = [];
        for (string a in args) {
            if (a == "-r" || a == "-R") {
                recursive = true;
            } else {
                paths.add(a);
            }
        }

        if (paths.length < 2) {
            Console.log("cp: missing destination");
            return;
        }

        string src = "";
        if (paths[0].startsWith("/")) {
            src = VFS.normalizePath(paths[0]);
        } else {
            src = VFS.resolvePath(currentDir, paths[0]);
        }

        string dst = "";
        if (paths[1].startsWith("/")) {
            dst = VFS.normalizePath(paths[1]);
        } else {
            dst = VFS.resolvePath(currentDir, paths[1]);
        }

        if (!VFS.exists(src)) {
            Console.setColor(ERROR_COLOR);
            Console.log("cp: cannot stat '${paths[0]}': No such file or directory");
            Console.setColor(TEXT_COLOR);
            return;
        }

        if (VFS.isDirectory(src) && !recursive) {
            Console.setColor(ERROR_COLOR);
            Console.log("cp: -r not specified; omitting directory '${paths[0]}'");
            Console.setColor(TEXT_COLOR);
            return;
        }

        # If dest is existing directory, copy into it
        if (VFS.isDirectory(dst)) {
            string name = VFS.basename(src);
            dst = dst + "/" + name;
        }

        bool ok = VFS.copy(src, dst);
        if (!ok) {
            Console.setColor(ERROR_COLOR);
            Console.log("cp: cannot copy '${paths[0]}' to '${paths[1]}'");
            Console.setColor(TEXT_COLOR);
        }
    }

    private static func cmdMv(list<string> args) -> void {
        if (args.length < 2) {
            Console.log("mv: missing operand");
            Console.log("Usage: mv <source> <destination>");
            return;
        }

        string src = "";
        if (args[0].startsWith("/")) {
            src = VFS.normalizePath(args[0]);
        } else {
            src = VFS.resolvePath(currentDir, args[0]);
        }

        string dst = "";
        if (args[1].startsWith("/")) {
            dst = VFS.normalizePath(args[1]);
        } else {
            dst = VFS.resolvePath(currentDir, args[1]);
        }

        if (!VFS.exists(src)) {
            Console.setColor(ERROR_COLOR);
            Console.log("mv: cannot stat '${args[0]}': No such file or directory");
            Console.setColor(TEXT_COLOR);
            return;
        }

        # If dest is existing directory, move into it
        if (VFS.isDirectory(dst)) {
            string name = VFS.basename(src);
            dst = dst + "/" + name;
        }

        bool ok = VFS.rename(src, dst);
        if (!ok) {
            Console.setColor(ERROR_COLOR);
            Console.log("mv: cannot move '${args[0]}' to '${args[1]}'");
            Console.setColor(TEXT_COLOR);
        }
    }

    private static func cmdDf(list<string> args) -> void {
        long usage = VFS.getTotalUsage();
        int entries = VFS.getEntryCount();
        long totalKb = 65536;  # 64 MB RAM filesystem budget
        long usedKb = usage / 1024;
        long freeKb = totalKb - usedKb;
        if (freeKb < 0) freeKb = 0;

        Console.log("Filesystem      Size     Used     Free   Entries");
        Console.log("ramfs         ${totalKb}K  ${usedKb}K  ${freeKb}K   ${entries}");
    }

    private static func cmdWrite(list<string> args) -> void {
        # write <file> <content...> - write text to a file
        if (args.length < 2) {
            Console.log("write: usage: write <file> <content...>");
            return;
        }

        string path = "";
        if (args[0].startsWith("/")) {
            path = VFS.normalizePath(args[0]);
        } else {
            path = VFS.resolvePath(currentDir, args[0]);
        }

        # Combine remaining args as content
        string content = "";
        for (int i = 1; i < args.length; i++) {
            if (i > 1) content += " ";
            content += args[i];
        }

        # Create parent if needed
        string parent = VFS.parentPath(path);
        if (!VFS.isDirectory(parent)) {
            Console.setColor(ERROR_COLOR);
            Console.log("write: '${args[0]}': parent directory does not exist");
            Console.setColor(TEXT_COLOR);
            return;
        }

        VFS.write(path, content);
    }

    private static func cmdHead(list<string> args) -> void {
        if (args.length == 0) {
            Console.log("head: missing file operand");
            return;
        }

        int lines = 10;
        string file = "";
        for (string a in args) {
            if (a.startsWith("-n")) {
                string numStr = a.substring(2, a.length - 2);
                lines = (int) numStr;
            } elif (!a.startsWith("-")) {
                file = a;
            }
        }

        if (file == "") {
            Console.log("head: missing file operand");
            return;
        }

        string path = "";
        if (file.startsWith("/")) {
            path = VFS.normalizePath(file);
        } else {
            path = VFS.resolvePath(currentDir, file);
        }

        if (!VFS.isFile(path)) {
            Console.setColor(ERROR_COLOR);
            Console.log("head: cannot open '${file}': No such file");
            Console.setColor(TEXT_COLOR);
            return;
        }

        string content = VFS.read(path);
        int lineCount = 0;
        int start = 0;
        for (int i = 0; i < content.length; i++) {
            if (content.charAt(i) == '\n') {
                lineCount++;
                if (lineCount <= lines) {
                    Console.log(content.substring(start, i - start));
                }
                start = i + 1;
            }
        }
        # Print trailing content if within limit
        if (lineCount < lines && start < content.length) {
            Console.log(content.substring(start, content.length - start));
        }
    }

    private static func cmdWc(list<string> args) -> void {
        if (args.length == 0) {
            Console.log("wc: missing file operand");
            return;
        }

        for (string a in args) {
            if (a.startsWith("-")) continue;

            string path = "";
            if (a.startsWith("/")) {
                path = VFS.normalizePath(a);
            } else {
                path = VFS.resolvePath(currentDir, a);
            }

            if (!VFS.isFile(path)) {
                Console.setColor(ERROR_COLOR);
                Console.log("wc: ${a}: No such file");
                Console.setColor(TEXT_COLOR);
                continue;
            }

            string content = VFS.read(path);
            int lineCount = 0;
            int wordCount = 0;
            bool inWord = false;
            for (int i = 0; i < content.length; i++) {
                char c = content.charAt(i);
                if (c == '\n') lineCount++;
                if (c == ' ' || c == '\n' || c == '\t') {
                    inWord = false;
                } elif (!inWord) {
                    inWord = true;
                    wordCount++;
                }
            }
            Console.log("  ${lineCount}  ${wordCount}  ${content.length}  ${a}");
        }
    }

    private static func cmdHistory(list<string> args) -> void {
        for (int i = 0; i < commandHistory.length; i++) {
            Console.log("  ${i + 1}  ${commandHistory[i]}");
        }
    }

    private static func cmdExport(list<string> args) -> void {
        if (args.length == 0) {
            cmdEnv(args);
            return;
        }
        string arg = args[0];
        int eqIndex = arg.indexOf("=");
        if (eqIndex > 0) {
            string key = arg.substring(0, eqIndex);
            string val = arg.substring(eqIndex + 1, arg.length - eqIndex - 1);
            setEnv(key, val);
        }
    }

    private static func cmdEnv(list<string> args) -> void {
        for (int i = 0; i < envKeys.length; i++) {
            Console.log("${envKeys[i]}=${envValues[i]}");
        }
    }

    private static func cmdWhoami(list<string> args) -> void {
        Console.log(username);
    }

    private static func cmdHostname(list<string> args) -> void {
        Console.log(hostname);
    }

    private static func cmdUname(list<string> args) -> void {
        bool showAll = false;
        for (string a in args) {
            if (a == "-a") showAll = true;
        }
        if (showAll) {
            Console.log("StratOS stratos 0.1.0 x86_64 Flux");
        } else {
            Console.log("StratOS");
        }
    }

