        Console.setColor(0xFFB74DFF); Console.write("###");
        Console.setColor(0x69F0AEFF); Console.write("###");
        Console.setColor(0x5B8CFFFF); Console.write("###");
        Console.setColor(0xBB86FCFF); Console.write("###");
        Console.setColor(0xC8D0E0FF); Console.write("###");
