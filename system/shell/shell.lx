    private static func cmdExit(list<string> args) -> void {
        Console.log("Returning to desktop...");
    }

    private static func cmdReboot(list<string> args) -> void {
        Console.log("Rebooting...");
        unsafe {
            # Triple-fault to reboot (pulse reset line via keyboard controller)
            outb(0x64, 0xFE);
        }
    }

    private static func cmdShutdown(list<string> args) -> void {
        Console.log("Powering off...");
        Console.log("It is now safe to turn off your computer.");
        unsafe {
            # ACPI shutdown (QEMU specific: port 0x604)
            outw(0x604, 0x2000);
            # Fallback: halt
            asm("cli");
            asm("hlt");
        }
    }

    private static func cmdFlux(list<string> args) -> void {
        Console.setColor(HIGHLIGHT_COLOR);
        Console.log("Flux REPL v0.1.0 - \"From the Void, Structure.\"");
        Console.log("Type 'exit' to return to shell");
        Console.setColor(TEXT_COLOR);
        Console.log("");

        # Enter REPL loop
        while (true) {
            Console.setColor(PROMPT_USER_COLOR);
            Console.write("flux> ");
            Console.setColor(TEXT_COLOR);

            string input = Keyboard.readLine();
            if (input.trim() == "exit") break;

            # Execute Flux code via JIT
            if (input.trim().length > 0) {
                Console.setColor(HIGHLIGHT_COLOR);
                Console.log("  [JIT] $input");
                Console.setColor(TEXT_COLOR);
                # exec(input, mode: "sandbox");
            }
        }
    }

    private static func cmdQuantum(list<string> args) -> void {
        if (args.length == 0) {
            Console.setColor(HIGHLIGHT_COLOR);
            Console.log("quantum - StratOS Package Manager v0.1.0");
            Console.setColor(TEXT_COLOR);
            Console.log("");
            Console.log("  quantum install <pkg> [--url <url>]  Install a package");
            Console.log("  quantum remove <pkg> [--force]       Remove a package");
            Console.log("  quantum update                       Update package registry");
            Console.log("  quantum search <query>               Search available packages");
            Console.log("  quantum list                         List installed packages");
            Console.log("  quantum info <pkg>                   Show package details");
            Console.log("  quantum set-url <url>                Set default registry URL");
            Console.log("  quantum get-url                      Show current registry URL");
            Console.log("");
            Console.log("  Registry: ${quantumRegistryUrl}");
            Console.log("");
            return;
        }

        # Ensure quantum directories exist
        VFS.mkdirp("/var/lib/quantum/installed");
        VFS.mkdirp("/var/lib/quantum/registry");
        VFS.mkdirp("/var/lib/quantum/cache");
        VFS.mkdirp("/etc/quantum");

        # Load registry URL from config if saved
        if (VFS.isFile("/etc/quantum/sources.conf")) {
            quantumRegistryUrl = VFS.read("/etc/quantum/sources.conf");
        }

        # Seed the registry if empty
        if (!VFS.isFile("/var/lib/quantum/registry/index")) {
            quantumSeedRegistry();
        }

        # Seed default installed packages if first run
        if (!VFS.isFile("/var/lib/quantum/installed/flux")) {
            VFS.write("/var/lib/quantum/installed/flux", "0.1.0|Flux language runtime|core|a1b2c3d4");
            VFS.write("/var/lib/quantum/installed/void-utils", "0.1.0|Core system utilities|core|e5f6a7b8");
        }

        string subcmd = args[0];
        switch (subcmd) {
            case "install":
                quantumInstall(args);
                break;
            case "remove":
                quantumRemove(args);
                break;
            case "list":
                quantumList();
                break;
            case "search":
                quantumSearch(args);
                break;
            case "info":
                quantumInfo(args);
                break;
            case "update":
                quantumUpdate();
                break;
            case "set-url":
                if (args.length < 2) {
                    Console.log("quantum: usage: quantum set-url <url>");
                } else {
                    quantumRegistryUrl = args[1];
                    VFS.write("/etc/quantum/sources.conf", args[1]);
                    Console.setColor(PROMPT_PATH_COLOR);
                    Console.log("Registry URL set to: ${args[1]}");
                    Console.setColor(TEXT_COLOR);
                }
                break;
            case "get-url":
                Console.log("Registry: ${quantumRegistryUrl}");
                break;
            default:
                Console.setColor(ERROR_COLOR);
                Console.log("quantum: unknown command '${subcmd}'");
                Console.setColor(TEXT_COLOR);
                Console.log("Run 'quantum' for usage information.");
                break;
        }
    }

    private static func quantumSeedRegistry() -> void {
        string registry = "";
        registry += "flux|0.1.0|Flux language runtime|core|a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2\n";
        registry += "nova|0.1.0|Text editor|app|b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3\n";
        registry += "drift|0.1.0|File explorer|app|c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4\n";
        registry += "nebula|0.1.0|Web browser|app|d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5\n";
        registry += "pulsar|0.1.0|Music player|app|e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6\n";
        registry += "cosmos|0.1.0|Desktop environment|system|f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7\n";
        registry += "stellar|0.1.0|Window compositor|system|a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8\n";
        registry += "orbit|0.1.0|Task manager|app|b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9\n";
        registry += "photon|0.1.0|Image viewer|app|c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0\n";
        registry += "echo|0.1.0|Audio framework|lib|d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1\n";
        registry += "void-utils|0.1.0|Core system utilities|core|e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6\n";
        registry += "libcrypt|0.1.0|Cryptography library|lib|f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3\n";
        registry += "netstack|0.1.0|Network stack|lib|a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4\n";
        VFS.write("/var/lib/quantum/registry/index", registry);
    }

    # Ask the user a Y/n confirmation question
    private static func confirmPrompt(string question) -> bool {
        Console.setColor(HIGHLIGHT_COLOR);
        Console.write("${question} [Y/n] ");
        Console.setColor(TEXT_COLOR);

        while (true) {
            if (!Keyboard.hasKey()) continue;
            KeyEvent ev = Keyboard.pollKey();
            if (!ev.pressed) continue;

            if (ev.ascii == 'y' || ev.ascii == 'Y' || ev.scancode == KEY_ENTER) {
                Console.log("Y");
                return true;
            } elif (ev.ascii == 'n' || ev.ascii == 'N') {
                Console.log("n");
                return false;
            }
        }
        return false;
    }

    private static func quantumInstall(list<string> args) -> void {
        if (args.length < 2) {
            Console.log("quantum: missing package name");
            Console.log("Usage: quantum install <pkg> [--url <url>]");
            return;
        }

        string pkg = args[1];
        string overrideUrl = "";

        # Parse --url flag
        for (int i = 2; i < args.length; i++) {
            if (args[i] == "--url" && i + 1 < args.length) {
                overrideUrl = args[i + 1];
                i++;
            }
        }

        string sourceUrl = quantumRegistryUrl;
        if (overrideUrl.length > 0) {
            sourceUrl = overrideUrl;
        }

        string installedPath = "/var/lib/quantum/installed/" + pkg;

        # Check if already installed
        if (VFS.isFile(installedPath)) {
            Console.log("quantum: '${pkg}' is already installed");
            return;
        }

        # Find in registry
        string registry = VFS.read("/var/lib/quantum/registry/index");
        bool found = false;
        string version = "";
        string desc = "";
        string category = "";
        string expectedHash = "";

        # Parse registry line by line
        int start = 0;
        for (int i = 0; i <= registry.length; i++) {
            bool atEnd = (i == registry.length);
            bool atNewline = false;
            if (!atEnd) {
                if (registry.charAt(i) == '\n') atNewline = true;
            }
            if (atEnd || atNewline) {
                if (i > start) {
                    string line = registry.substring(start, i - start);
                    # Parse: name|version|desc|category|sha256
                    int p1 = line.indexOf("|");
                    if (p1 > 0) {
                        string name = line.substring(0, p1);
                        if (name == pkg) {
                            found = true;
                            string rest = line.substring(p1 + 1, line.length - p1 - 1);
                            int p2 = rest.indexOf("|");
                            if (p2 > 0) {
                                version = rest.substring(0, p2);
                                string rest2 = rest.substring(p2 + 1, rest.length - p2 - 1);
                                int p3 = rest2.indexOf("|");
                                if (p3 > 0) {
                                    desc = rest2.substring(0, p3);
                                    string rest3 = rest2.substring(p3 + 1, rest2.length - p3 - 1);
                                    int p4 = rest3.indexOf("|");
                                    if (p4 > 0) {
                                        category = rest3.substring(0, p4);
                                        expectedHash = rest3.substring(p4 + 1, rest3.length - p4 - 1);
                                    } else {
                                        category = rest3;
                                    }
                                } else {
                                    desc = rest2;
                                }
                            }
                        }
                    }
                }
                start = i + 1;
            }
        }

        if (!found) {
            Console.setColor(ERROR_COLOR);
            Console.log("quantum: package '${pkg}' not found in registry");
            Console.setColor(TEXT_COLOR);
            Console.log("Try 'quantum search ${pkg}' or install from URL:");
            Console.log("  quantum install ${pkg} --url <url>");
            return;
        }

        # Display package metadata
        Console.log("");
        Console.setColor(HIGHLIGHT_COLOR);
        Console.log("Package:     ${pkg} ${version}");
        Console.setColor(TEXT_COLOR);
        Console.log("Description: ${desc}");
        Console.log("Category:    ${category}");
        Console.log("Source:      ${sourceUrl}");
        if (expectedHash.length > 0) {
            Console.log("SHA256:      ${expectedHash}");
        }
        Console.log("");

        # Ask for confirmation
        if (!confirmPrompt(":: Proceed with installation?")) {
            Console.log("Installation cancelled.");
            return;
        }

        Console.log("");
        Console.setColor(PROMPT_PATH_COLOR);
        Console.log(":: Fetching ${pkg}-${version}.qpkg from ${sourceUrl}...");
        Console.setColor(TEXT_COLOR);
        Console.log("   Resolving dependencies...");
        Console.log("   Downloading ${pkg}-${version}.qpkg...");

        # Simulate SHA256 verification
        string downloadedHash = expectedHash;
        if (expectedHash.length > 0) {
            Console.log("   Verifying SHA256 integrity...");
            if (downloadedHash == expectedHash) {
                Console.setColor(PROMPT_PATH_COLOR);
                Console.log("   SHA256 verified: OK");
                Console.setColor(TEXT_COLOR);
            } else {
                Console.setColor(ERROR_COLOR);
                Console.log("   SHA256 MISMATCH!");
                Console.log("   Expected: ${expectedHash}");
                Console.log("   Got:      ${downloadedHash}");
                Console.setColor(TEXT_COLOR);
                Console.log("");
                if (!confirmPrompt("   Integrity check failed. Install anyway?")) {
                    Console.log("   Installation aborted.");
                    return;
                }
            }
        }

        Console.log("   Installing to /usr/lib/${pkg}/...");

        # Create package directory and manifest
        VFS.mkdirp("/usr/lib/" + pkg);
        string manifest = "${version}|${desc}|${category}|${expectedHash}";
        VFS.write(installedPath, manifest);

        # Write package receipt to cache
        VFS.write("/var/lib/quantum/cache/" + pkg + ".receipt", "source=${sourceUrl}\nversion=${version}\nhash=${expectedHash}\n");

        Console.setColor(PROMPT_PATH_COLOR);
        Console.log("   ${pkg} ${version} installed successfully.");
        Console.setColor(TEXT_COLOR);
        Console.log("");
    }

    private static func quantumRemove(list<string> args) -> void {
        if (args.length < 2) {
            Console.log("quantum: missing package name");
            return;
        }

        string pkg = args[1];
        string installedPath = "/var/lib/quantum/installed/" + pkg;

        if (!VFS.isFile(installedPath)) {
            Console.setColor(ERROR_COLOR);
            Console.log("quantum: package '${pkg}' is not installed");
            Console.setColor(TEXT_COLOR);
            return;
        }

        # Don't allow removing core packages without --force
        string manifest = VFS.read(installedPath);
        bool isCore = (manifest.indexOf("|core|") >= 0);
        bool forceRemove = false;
        for (int i = 2; i < args.length; i++) {
            if (args[i] == "--force" || args[i] == "-f") forceRemove = true;
        }

        if (isCore && !forceRemove) {
            Console.setColor(ERROR_COLOR);
            Console.log("quantum: '${pkg}' is a core package. Use --force to remove.");
            Console.setColor(TEXT_COLOR);
            return;
        }

        # Confirm removal
        if (!confirmPrompt(":: Remove ${pkg}?")) {
            Console.log("Removal cancelled.");
            return;
        }

        Console.setColor(PROMPT_PATH_COLOR);
        Console.log(":: Removing ${pkg}...");
        Console.setColor(TEXT_COLOR);

        VFS.remove(installedPath);
        VFS.removeRecursive("/usr/lib/" + pkg);
        VFS.remove("/var/lib/quantum/cache/" + pkg + ".receipt");

        Console.log("   ${pkg} removed successfully.");
    }

    private static func quantumUpdate() -> void {
        Console.setColor(PROMPT_PATH_COLOR);
        Console.log(":: Synchronizing package registry...");
        Console.log("   Fetching index from ${quantumRegistryUrl}...");
        Console.setColor(TEXT_COLOR);

        # Re-seed the registry (simulates fetching from remote)
        quantumSeedRegistry();

        # Count packages
        string registry = VFS.read("/var/lib/quantum/registry/index");
        int pkgCount = 0;
        for (int i = 0; i < registry.length; i++) {
            if (registry.charAt(i) == '\n') pkgCount++;
        }

        Console.log("   Registry updated: ${pkgCount} packages available.");
        Console.log("   Source: ${quantumRegistryUrl}");
    }

    private static func quantumList() -> void {
        Console.setColor(HIGHLIGHT_COLOR);
        Console.log("Installed packages:");
        Console.setColor(TEXT_COLOR);
        Console.log("");

        list<FileInfo> pkgs = VFS.listDir("/var/lib/quantum/installed");
        if (pkgs.length == 0) {
            Console.log("  (no packages installed)");
            return;
        }

        for (FileInfo fi in pkgs) {
            if (fi.type == 1) continue;
            string manifest = VFS.read("/var/lib/quantum/installed/" + fi.name);
            int p1 = manifest.indexOf("|");
            string version = "???";
            string desc = "";
            if (p1 > 0) {
                version = manifest.substring(0, p1);
                string rest = manifest.substring(p1 + 1, manifest.length - p1 - 1);
                int p2 = rest.indexOf("|");
                if (p2 > 0) {
                    desc = rest.substring(0, p2);
                } else {
                    desc = rest;
                }
            }

            string name = fi.name;
            while (name.length < 16) name = name + " ";
            Console.log("  ${name}${version}   ${desc}");
        }
        Console.log("");
    }

    private static func quantumSearch(list<string> args) -> void {
        if (args.length < 2) {
            Console.log("quantum: missing search query");
            return;
        }

        string query = args[1];
        string registry = VFS.read("/var/lib/quantum/registry/index");
        int matchCount = 0;

        Console.setColor(HIGHLIGHT_COLOR);
        Console.log("Search results for '${query}':");
        Console.setColor(TEXT_COLOR);
        Console.log("");

        int start = 0;
        for (int i = 0; i <= registry.length; i++) {
            bool atEnd = (i == registry.length);
            bool atNewline = false;
            if (!atEnd) {
                if (registry.charAt(i) == '\n') atNewline = true;
            }
            if (atEnd || atNewline) {
                if (i > start) {
                    string line = registry.substring(start, i - start);
                    if (line.indexOf(query) >= 0) {
                        int p1 = line.indexOf("|");
                        if (p1 > 0) {
                            string name = line.substring(0, p1);
                            string rest = line.substring(p1 + 1, line.length - p1 - 1);
                            int p2 = rest.indexOf("|");
                            string version = "???";
                            string desc = "";
                            if (p2 > 0) {
                                version = rest.substring(0, p2);
                                string rest2 = rest.substring(p2 + 1, rest.length - p2 - 1);
                                int p3 = rest2.indexOf("|");
                                if (p3 > 0) {
                                    desc = rest2.substring(0, p3);
                                } else {
                                    desc = rest2;
                                }
                            }

                            string installed = "";
                            if (VFS.isFile("/var/lib/quantum/installed/" + name)) {
                                installed = " [installed]";
                            }

                            while (name.length < 16) name = name + " ";
                            Console.log("  ${name}${version}   ${desc}${installed}");
                            matchCount++;
                        }
                    }
                }
                start = i + 1;
            }
        }

        if (matchCount == 0) {
            Console.log("  No packages matching '${query}' found.");
        }
        Console.log("");
    }

    private static func quantumInfo(list<string> args) -> void {
        if (args.length < 2) {
            Console.log("quantum: missing package name");
            return;
        }

        string pkg = args[1];
        string registry = VFS.read("/var/lib/quantum/registry/index");
        bool found = false;
        string version = "";
        string desc = "";
        string category = "";
        string hash = "";

        int start = 0;
        for (int i = 0; i <= registry.length; i++) {
            bool atEnd = (i == registry.length);
            bool atNewline = false;
            if (!atEnd) {
                if (registry.charAt(i) == '\n') atNewline = true;
            }
            if (atEnd || atNewline) {
                if (i > start) {
                    string line = registry.substring(start, i - start);
                    int p1 = line.indexOf("|");
                    if (p1 > 0) {
                        string name = line.substring(0, p1);
                        if (name == pkg) {
                            found = true;
                            string rest = line.substring(p1 + 1, line.length - p1 - 1);
                            int p2 = rest.indexOf("|");
                            if (p2 > 0) {
                                version = rest.substring(0, p2);
                                string rest2 = rest.substring(p2 + 1, rest.length - p2 - 1);
                                int p3 = rest2.indexOf("|");
                                if (p3 > 0) {
                                    desc = rest2.substring(0, p3);
                                    string rest3 = rest2.substring(p3 + 1, rest2.length - p3 - 1);
                                    int p4 = rest3.indexOf("|");
                                    if (p4 > 0) {
                                        category = rest3.substring(0, p4);
                                        hash = rest3.substring(p4 + 1, rest3.length - p4 - 1);
                                    } else {
                                        category = rest3;
                                    }
                                } else {
                                    desc = rest2;
                                }
                            }
                        }
                    }
                }
                start = i + 1;
            }
        }

        if (!found) {
            Console.setColor(ERROR_COLOR);
            Console.log("quantum: package '${pkg}' not found");
            Console.setColor(TEXT_COLOR);
            return;
        }

        bool isInstalled = VFS.isFile("/var/lib/quantum/installed/" + pkg);

        Console.setColor(HIGHLIGHT_COLOR);
        Console.log("Package: ${pkg}");
        Console.setColor(TEXT_COLOR);
        Console.log("  Version:     ${version}");
        Console.log("  Description: ${desc}");
        Console.log("  Category:    ${category}");
        Console.log("  Registry:    ${quantumRegistryUrl}");
        if (hash.length > 0) {
            Console.log("  SHA256:      ${hash}");
        }
        if (isInstalled) {
            Console.setColor(PROMPT_PATH_COLOR);
            Console.log("  Status:      installed");
        } else {
            Console.log("  Status:      not installed");
        }
        Console.setColor(TEXT_COLOR);
        Console.log("");
    }

    # ========================================================================
    # Privilege & Identity Commands
    # ========================================================================

    private static func cmdSudo(list<string> args) -> void {
        if (args.length == 0) {
            Console.log("sudo: usage: sudo <command> [args...]");
            return;
        }

        # Reconstruct the sub-command string
        string subcmd = args[0];
        for (int i = 1; i < args.length; i++) {
            subcmd = subcmd + " " + args[i];
        }

        bool wasRoot = isRoot;
        isRoot = true;
        executeCommand(subcmd);
        isRoot = wasRoot;
    }

    private static func cmdSu(list<string> args) -> void {
        if (args.length > 0 && args[0] == "-" || args.length == 0) {
            # Switch to root
            isRoot = true;
            username = "root";
            setEnv("USER", "root");
            setEnv("HOME", "/root");
            currentDir = "/root";
            VFS.mkdirp("/root");
            Console.setColor(ERROR_COLOR);
            Console.log("Switched to root.");
            Console.setColor(TEXT_COLOR);
        } elif (args[0] == "void" || args[0] == "-l" || args[0] == "--login") {
            isRoot = false;
            username = "void";
            setEnv("USER", "void");
            setEnv("HOME", "/home/void");
            currentDir = "/home/void";
            Console.log("Switched to void.");
        } else {
            Console.log("su: user '${args[0]}' does not exist");
        }
    }

    private static func cmdId(list<string> args) -> void {
        if (isRoot) {
            Console.log("uid=0(root) gid=0(root) groups=0(root)");
        } else {
            Console.log("uid=1000(void) gid=1000(void) groups=1000(void),27(sudo)");
        }
    }

    # ========================================================================
    # Networking Commands (simulated)
    # ========================================================================

    private static func cmdPing(list<string> args) -> void {
        if (args.length == 0) {
            Console.log("ping: usage: ping <host>");
            return;
        }

        if (!E1000.isPresent() || !Net.isConfigured()) {
            Console.setColor(HIGHLIGHT_COLOR);
            Console.log("ping: network not available");
            Console.setColor(TEXT_COLOR);
            return;
        }

        string host = args[0];

        # Try to parse as IP address; otherwise do DNS lookup
        int targetIP = parseIPAddress(host);
        if (targetIP == 0) {
            Console.log("Resolving ${host}...");
            targetIP = Net.dnsResolve(host);
            if (targetIP == 0) {
                Console.log("ping: cannot resolve ${host}: Unknown host");
                return;
            }
        }

        string targetStr = ipToStrShell(targetIP);
        Console.log("PING ${host} (${targetStr}) 56(84) bytes of data.");

        int sent = 0;
        int received = 0;
        int count = 4;

        for (int i = 1; i <= count; i++) {
            # Send ICMP echo request via raw UDP to simulate
            # (Real ICMP requires raw IP access — we use UDP to gateway for now)
            long startMs = Timer.getElapsedMs();

            # Process network to send/receive
            Net.processIncoming();

            long endMs = Timer.getElapsedMs();
            int latency = (int)(endMs - startMs);
            if (latency < 1) latency = 1;

            sent++;
            received++;
            Console.log("64 bytes from ${targetStr}: icmp_seq=${i} ttl=64 time=${latency} ms");

            # Brief delay between pings
            for (int w = 0; w < 100000; w++) { }
        }

        Console.log("");
        Console.log("--- ${host} ping statistics ---");
        int loss = ((sent - received) * 100) / sent;
        Console.log("${sent} packets transmitted, ${received} received, ${loss}% packet loss");
    }

    # ========================================================================
    # File Permission Commands (simulated)
    # ========================================================================

    private static func cmdChmod(list<string> args) -> void {
        if (args.length < 2) {
            Console.log("chmod: usage: chmod <mode> <file>");
            return;
        }

        string mode = args[0];
        string file = args[1];
        string path = resolvePath(file);

        if (!VFS.isFile(path) && !VFS.isDirectory(path)) {
            Console.log("chmod: cannot access '${file}': No such file or directory");
            return;
        }

        Console.log("mode of '${file}' changed to ${mode}");
    }

    private static func cmdChown(list<string> args) -> void {
        if (args.length < 2) {
            Console.log("chown: usage: chown <owner[:group]> <file>");
            return;
        }

        string owner = args[0];
        string file = args[1];
        string path = resolvePath(file);

        if (!VFS.isFile(path) && !VFS.isDirectory(path)) {
            Console.log("chown: cannot access '${file}': No such file or directory");
            return;
        }

        Console.log("ownership of '${file}' changed to ${owner}");
    }

    # ========================================================================
    # Search & Discovery Commands
    # ========================================================================

    private static func cmdGrep(list<string> args) -> void {
        if (args.length < 2) {
            Console.log("grep: usage: grep <pattern> <file>");
            return;
        }

        string pattern = args[0];
        string file = args[1];
        string path = resolvePath(file);

        if (!VFS.isFile(path)) {
            Console.log("grep: ${file}: No such file or directory");
            return;
        }

        string content = VFS.read(path);
        int lineNum = 1;
        int matchCount = 0;
        int start = 0;

        for (int i = 0; i <= content.length; i++) {
            bool atEnd = (i == content.length);
            bool atNewline = false;
            if (!atEnd) {
                if (content.charAt(i) == '\n') atNewline = true;
            }
            if (atEnd || atNewline) {
                if (i > start) {
                    string line = content.substring(start, i - start);
                    if (line.indexOf(pattern) >= 0) {
                        Console.setColor(PROMPT_PATH_COLOR);
                        Console.write("${lineNum}: ");
                        Console.setColor(TEXT_COLOR);
                        Console.log(line);
                        matchCount++;
                    }
                }
                lineNum++;
                start = i + 1;
            }
        }

        if (matchCount == 0) {
            Console.log("(no matches)");
        }
    }

    private static func cmdFind(list<string> args) -> void {
        if (args.length == 0) {
            Console.log("find: usage: find <path> [-name <pattern>]");
            return;
        }

        string searchDir = resolvePath(args[0]);
        string namePattern = "";

        # Parse -name flag
        for (int i = 1; i < args.length; i++) {
            if (args[i] == "-name" && i + 1 < args.length) {
                namePattern = args[i + 1];
                i++;
            }
        }

        if (!VFS.isDirectory(searchDir)) {
            Console.log("find: '${args[0]}': No such directory");
            return;
        }

        # List all entries in directory (non-recursive in VFS for now)
        list<FileInfo> entries = VFS.listDir(searchDir);
        for (FileInfo fi in entries) {
            string fullPath = searchDir;
            if (searchDir != "/") fullPath = searchDir + "/";
            fullPath = fullPath + fi.name;

            if (namePattern.length > 0) {
                if (fi.name.indexOf(namePattern) >= 0) {
                    Console.log(fullPath);
                }
            } else {
                Console.log(fullPath);
            }

            # Recurse into subdirectories
            if (fi.type == 1) {
                list<FileInfo> subEntries = VFS.listDir(fullPath);
                for (FileInfo sub in subEntries) {
                    string subPath = fullPath + "/" + sub.name;
                    if (namePattern.length > 0) {
                        if (sub.name.indexOf(namePattern) >= 0) {
                            Console.log(subPath);
                        }
                    } else {
                        Console.log(subPath);
                    }
                }
            }
        }
    }

    private static func cmdWhich(list<string> args) -> void {
        if (args.length == 0) {
            Console.log("which: usage: which <command>");
            return;
        }

        string cmd = args[0];

        # Check if it's a builtin
        for (string b in builtinCommands) {
            if (b == cmd) {
                Console.log("/usr/bin/${cmd}");
                return;
            }
        }

        Console.log("${cmd} not found");
    }

